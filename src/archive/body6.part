<style>
.topbar{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap}
.cfgBtn{display:flex;align-items:center;gap:10px;padding:8px 14px;border:1px solid var(--line);border-radius:12px;background:var(--card);color:var(--ink);cursor:pointer;text-align:left}
.cfgBtn:hover{border-color:var(--acc)}
.cfgBtn svg{width:20px;height:20px;color:var(--mute)}
.cfgBtn b{display:block;font-size:13.5px}
.cfgBtn span{font-size:11.5px;color:var(--mute)}
.cfgBtn.mod svg{color:var(--acc)}
.cfgBtn .dot{width:8px;height:8px;border-radius:50%;background:var(--acc);display:none}
.cfgBtn.mod .dot{display:inline-block}
.stageTools{position:absolute;right:12px;top:10px;z-index:4;display:flex;gap:8px;align-items:center}
.runNote{font-size:11.5px;color:var(--acc);background:var(--accbg);border-radius:999px;padding:3px 10px;display:none;cursor:pointer}
.runNote.on{display:inline-block}
.infoRow{opacity:.62}
.infoRow input[type=text]{width:100%;padding:6px 8px;border:1.5px dashed var(--line);border-radius:10px;background:transparent;color:var(--ink);font-size:14px}
.infoTag{font-size:10.5px;font-weight:700;color:var(--mute);border:1px solid var(--line);border-radius:4px;padding:0 5px;margin-left:6px;text-transform:uppercase;letter-spacing:.04em}
.chk{display:flex;align-items:center;gap:8px;font-size:13.5px;font-weight:600;cursor:pointer;margin:12px 0 4px}
.chk input{width:18px;height:18px;accent-color:var(--acc)}
.pop.wide{width:410px}
.grpTbl{width:100%;border-collapse:collapse;margin-top:6px;font-size:13px}
.grpTbl td{padding:4px 2px}
.grpTbl input{width:70px;padding:5px 6px;border:1.5px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink);font-size:14px;text-align:right;font-weight:700}
.warnTxt{font-size:12px;color:var(--ad);margin-top:4px}
.tagBox{border-radius:10px;padding:8px 10px;font-size:13px;margin-top:10px}
.tagBox.S{background:var(--fitbg)}.tagBox.N{background:var(--adbg)}.tagBox.C{background:var(--bebg)}
.tg{font-weight:800;font-size:12px;padding:2px 9px;border-radius:999px;white-space:nowrap;display:inline-block;margin-right:6px}
.tg.S{background:var(--fitbg);color:var(--fit)}.tg.N{background:var(--adbg);color:var(--ad)}.tg.C{background:var(--bebg);color:var(--be)}
.calcBox{background:var(--accbg);border-radius:10px;padding:8px 10px;font-size:12.5px;margin-top:8px}
.fx{margin-top:6px}
.fxBtn{border:0;background:none;color:var(--acc);font-weight:700;font-size:12.5px;cursor:pointer;padding:2px 0}
.fxBody{background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:8px 10px;margin-top:4px;font-size:12.5px}
.fxBody .f{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:11.5px;display:block;margin:3px 0;white-space:pre-wrap}
.fxBody table{width:100%;border-collapse:collapse;margin-top:6px}
.fxBody td{padding:3px 2px;border-top:1px solid var(--line);font-size:12px;vertical-align:middle}
.fxBody input{width:80px;padding:3px 5px;border:1px solid var(--line);border-radius:6px;background:var(--card);color:var(--ink);text-align:right;font-size:12.5px}
.fxBody tr.ov td{background:var(--accbg)}
.conf{font-weight:800;font-size:11px;color:var(--mute)}
.plats{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px}
@media(max-width:900px){.plats{grid-template-columns:1fr}}
.pcard{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:12px 14px}
.pcard h3{margin:0;font-size:15px;display:flex;justify-content:space-between;align-items:center;gap:8px}
.pcard .psub{font-size:12px;color:var(--mute);margin:2px 0 6px}
.zc{font-size:11.5px;font-weight:800;padding:2px 8px;border-radius:999px;white-space:nowrap;display:inline-block}
.zc.F{background:var(--fitbg);color:var(--fit)}.zc.A{background:var(--adbg);color:var(--ad)}.zc.B{background:var(--bebg);color:var(--be)}
.crow{border-top:1px solid var(--line);padding:7px 0}
.crow:first-of-type{border-top:0}
.crow .ch{display:flex;gap:8px;align-items:baseline;flex-wrap:wrap}
.crow .cn{font-weight:700;font-size:13.5px;min-width:140px}
.crow .cm{font-size:12.5px;color:var(--mute);flex:1}
.whyBtn{border:1px solid var(--line);background:var(--bg);border-radius:999px;font-size:11.5px;font-weight:700;color:var(--acc);padding:2px 9px;cursor:pointer}
.sumBox{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px 16px;margin-top:12px}
.sumBox h2{margin:0 0 4px;font-size:17px}
.prof{width:100%;border-collapse:collapse}
.prof td{padding:6px 3px;border-top:1px solid var(--line);font-size:13px;vertical-align:top}
.prof td.v{text-align:right;font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap}
.prof th{font-size:11.5px;color:var(--mute);text-align:left;font-weight:600;padding:3px}
.bd{font-size:11px;font-weight:700;color:var(--acc);background:var(--accbg);border-radius:4px;padding:2px 7px;white-space:nowrap;cursor:pointer;display:inline-block;margin:1px 0}
.bd::after{content:" ⓘ";font-weight:400}
.expl td{background:var(--bg);font-size:12.5px;padding:8px 10px!important}
.scale{display:flex;gap:4px;flex-wrap:wrap;margin:4px 0 6px}
.scale span{font-size:11px;border:1px solid var(--line);border-radius:4px;padding:1px 6px;color:var(--mute)}
.scale span.on{background:var(--acc);color:#fff;border-color:var(--acc);font-weight:700}
.expl .f{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:11.5px;display:block;margin:4px 0}
.modal .fld.chg{background:var(--adbg);border-radius:8px;padding:4px 6px}
.estW{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:8px 10px;margin-top:8px}
.estTop{display:flex;gap:8px;align-items:baseline;flex-wrap:wrap;font-size:13.5px}
.estLbl{font-size:10.5px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--acc);background:var(--accbg);border-radius:4px;padding:1px 6px}
.accd{font-size:11.5px;color:var(--fit);font-weight:700}
.estAct{display:flex;gap:6px;margin-top:6px;flex-wrap:wrap}
.ea{border:1px solid var(--line);background:var(--bg);color:var(--ink);border-radius:999px;font-size:12px;font-weight:600;padding:3px 10px;cursor:pointer}
.ea:hover{border-color:var(--acc);color:var(--acc)}
.refs{display:flex;flex-direction:column;gap:6px;margin-top:6px}
.refRow{display:grid;grid-template-columns:1fr 92px 80px 26px;gap:6px;align-items:center}
.refRow input,.refRow select{padding:5px 7px;border:1.5px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink);font-size:13.5px;width:100%}
.refRow input[type=number]{text-align:right;font-weight:700}
.rm{border:0;background:none;color:var(--mute);font-size:18px;cursor:pointer}
.mini2{margin-top:8px;padding:5px 12px;font-size:12.5px}
.lensRow{display:flex;gap:14px;font-size:12.5px;color:var(--mute);margin:4px 0}
.volLine{font-size:12.5px;background:var(--bg);border-radius:8px;padding:6px 8px;margin:6px 0}
.lensH{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--mute);margin:10px 0 2px}
.zc.N{background:var(--line);color:var(--mute)}.zc.I{background:var(--accbg);color:var(--acc)}
.crow.na{opacity:.55}
</style>
<style>
.topBtns{display:flex;gap:8px;align-items:flex-start;flex-wrap:wrap}
.gDrawerBg{position:fixed;inset:0;background:rgba(10,12,20,.38);z-index:60;display:flex;justify-content:flex-end}
.gDrawer{width:min(1080px,100%);height:100%;background:var(--bg);display:flex;flex-direction:column;box-shadow:-12px 0 40px rgba(0,0,0,.18);animation:gIn .22s ease-out}
@keyframes gIn{from{transform:translateX(40px);opacity:.4}}
.gHead{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 20px;border-bottom:1px solid var(--line);background:var(--card)}
.gHead h2{margin:0;font-size:18px}
.gHead .note{margin:0}
.gBody{flex:1;display:flex;min-height:0}
.gNav{width:230px;flex:none;border-right:1px solid var(--line);padding:12px 8px;overflow:auto;background:var(--card)}
.gNav button{display:flex;gap:10px;align-items:center;width:100%;text-align:left;border:0;background:none;color:var(--ink);padding:9px 10px;border-radius:9px;font-size:13.5px;cursor:pointer}
.gNav button:hover{background:var(--accbg)}
.gNav button.on{background:var(--accbg);color:var(--acc);font-weight:700}
.gNav .num{font-size:11px;font-weight:800;color:var(--mute);width:16px}
.gNav .grp{font-size:10.5px;font-weight:800;color:var(--mute);text-transform:uppercase;letter-spacing:.06em;padding:12px 10px 4px}
.gMain{flex:1;overflow:auto;padding:22px 30px 60px}
.gMain h3{font-size:22px;margin:0 0 4px}
.gMain h4{font-size:15px;margin:22px 0 6px}
.gMain p,.gMain li{font-size:14px;line-height:1.55}
.gMain ul{padding-left:20px;margin:6px 0}
.gLead{font-size:15px!important;color:var(--mute)}
.gMain table{width:100%;border-collapse:collapse;margin:8px 0;font-size:13px}
.gMain th{text-align:left;font-size:11.5px;color:var(--mute);font-weight:700;padding:6px 6px;border-bottom:1.5px solid var(--line)}
.gMain td{padding:6px 6px;border-bottom:1px solid var(--line);vertical-align:top;line-height:1.45}
.gMain td.n{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.gMain a{color:var(--acc)}
.cfB{display:inline-block;min-width:18px;text-align:center;font-size:11px;font-weight:800;border-radius:5px;padding:1px 5px;background:var(--accbg);color:var(--acc)}
.cfB.E{background:var(--adbg);color:var(--ad)}.cfB.C{background:var(--idlebg);color:var(--mute)}
.fBox{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin:10px 0}
.fBox .fh{font-weight:800;font-size:14px;margin-bottom:4px}
.fBox code,.fCode{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12.5px;background:var(--accbg);color:var(--ink);border-radius:6px;padding:6px 9px;display:block;margin:6px 0;white-space:pre-wrap}
.fBox .ex{font-size:12.5px;color:var(--mute)}
.callout{border-left:4px solid var(--acc);background:var(--accbg);border-radius:0 10px 10px 0;padding:10px 14px;margin:12px 0;font-size:13.5px}
.callout.warn{border-color:var(--ad);background:var(--adbg)}
.diff{color:var(--ad);font-weight:700}
.ok{color:var(--fit);font-weight:700}
.cardRow{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:10px;margin:10px 0}
.miniCard{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 14px}
.miniCard b{display:block;font-size:14px;margin-bottom:4px}
.miniCard p{font-size:13px!important;margin:0;color:var(--mute)}
.spark{display:flex;gap:16px;flex-wrap:wrap}
.spark div{flex:1;min-width:220px;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px 12px}
.spark svg{width:100%;height:46px}
.gSearch{padding:7px 10px;border:1px solid var(--line);border-radius:9px;background:var(--bg);color:var(--ink);font-size:13px;width:200px}
.deckBg{position:fixed;inset:0;z-index:70;background:#0e1424;display:flex;flex-direction:column}
.deckTop{display:flex;justify-content:space-between;align-items:center;padding:8px 14px;color:#e6e9f0;font-size:13px}
.deckTop .btn{background:rgba(255,255,255,.1);color:#fff;border-color:rgba(255,255,255,.25)}
.deckBg iframe{flex:1;border:0;width:100%}
.infoLink{border:0;background:none;color:var(--acc);font-weight:700;font-size:12.5px;cursor:pointer;padding:0}
@media (max-width:760px){.gNav{width:64px}.gNav button span.t,.gNav .grp{display:none}.gMain{padding:16px}}
</style>
</head>
<body>
<main>
<div class="topbar">
 <div><h1>Volume &amp; Performance Calculator</h1><p class="sub">Describe one async interface from source to target. Tap each part, answer what you know, and see where each platform fits.</p></div>
 <div class="topBtns">
 <button class="cfgBtn" id="guideBtn" aria-label="Guide"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 21V5M8 7h7M8 11h7"/></svg><div><b>Guide</b><span>Ground rules · formulas · how to</span></div></button>
 <button class="cfgBtn" id="deckBtn" aria-label="Concepts presentation"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M12 16v4M8 20h8M10 8l4 2-4 2z"/></svg><div><b>Concepts</b><span>The ideas in 15 slides</span></div></button>
 <button class="cfgBtn" id="gear" aria-label="Calculation settings"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg><div><b>Calculation settings <i class="dot"></i></b><span>Formulas · limits · boundaries</span></div></button>
 </div>
</div>

<div class="stage" id="stage">
 <div class="stageTools"><span class="runNote" id="runNote" title="Click to undo the changes made for this run">Changed for this run · reset</span><button class="btn" id="clr" title="Clear all answers">Start over</button></div>
 <div class="hint" id="hint">Start anywhere: tap the source, the message, the pipes, the middleware or the target.</div>
 <div class="scroller"><svg class="flow" id="svg" viewBox="0 0 1000 380" role="img" aria-label="Async flow: source, influx, middleware, delivery, target"></svg></div>
 <div class="legend"><span style="--c:var(--idle)">not set yet</span><span style="--c:var(--fit)">Standard</span><span style="--c:var(--ad)">Needs attention</span><span style="--c:var(--be)">Critical</span><span style="--c:transparent">Scale of each part. Platform results are below.</span></div>
</div>

<div class="sumBox">
 <h2>Platform evaluation</h2>
 <p class="note" id="platNote">Each component is checked against your numbers. Tap “Why” to see the facts, the calculation and the limits, and to change them for this run. <button class="infoLink" data-guide="rules">ⓘ Ground rules and sources</button></p>
</div>
<div class="plats" id="plats"></div>
<div class="sumBox">
 <h2>Workload profile <span class="note">tap a band to see how it's calculated · <button class="infoLink" data-guide="profile">ⓘ how to read it</button></span></h2>
 <table class="prof" id="prof"></table>
 <div style="margin-top:10px"><button class="btn" id="copy">Copy summary</button> <span class="note" id="copied"></span></div>
</div>
</main>

<script>
/* ================= settings (saved defaults) + run overrides ================= */
const SET_DEF=[
 {g:"Answers translated into numbers",items:[
  ["t_w1","Processing time per message: simple","s",0.5,"E"],["t_w2","Processing time per message: medium","s",5,"E"],["t_w3","Processing time per message: complex","s",90,"E"],
  ["cap_one","Target at the same time: one at a time","calls",1,"E"],["cap_few","Target at the same time: a few","calls",10,"E"],["cap_dozens","Target at the same time: dozens","calls",50,"E"],["cap_hundreds","Target at the same time: hundreds","calls",500,"E"],
  ["tgtT","Target time to post one record","s",0.5,"E"],["smallF","Speed-up of small batches vs single calls","×",20,"E"],["bulkF","Speed-up of bulk or file vs single calls","×",200,"E"],
  ["fL","Large country, relative to a medium one","×",3,"E"],["fM","Medium country","×",1,"E"],["fS","Small country, relative to a medium one","×",0.3,"E"],
  ["workDays","Working days per month","days",21,"A"],["weekDays","Working days per week","days",5,"A"],["batchWin","A batch run delivers its messages within","min",60,"E"],["peakDur","Length of the busiest period","h",1,"E"],["valLen","Typical field value length (size calculation)","chars",12,"E"]]},
 {g:"Regions (UTC offset used)",items:[["oAM","Americas","h",-5,"E"],["oEM","EMEA","h",1,"E"],["oAP","Asia-Pacific","h",8,"E"]]},
 {g:"Message size scale (band edges)",items:[["sz1","Size starts to matter above","KB",250,"A"],["sz2","Second edge","MB",1,"A"],["sz3","Third edge","MB",10,"B"],["sz4","Fourth edge","MB",30,"A"],["sz5","Fifth edge","MB",100,"A"]]},
 {g:"Volume scale (edges per hour = throughput ÷ biggest message, capped by count)",items:[["tp1","Throughput edge 1","GB/h",0.25,"E"],["tp2","Throughput edge 2","GB/h",2.5,"E"],["tp3","Throughput edge 3","GB/h",25,"E"],["cnt1","Count edge 1","msgs/h",5000,"E"],["cnt2","Count edge 2","msgs/h",50000,"E"],["cnt3","Count edge 3","msgs/h",500000,"E"]]},
 {g:"Boundaries for the scale tags",items:[
  ["rateW","Busiest hour: Needs attention above","/h",50000,"E"],["rateC","Busiest hour: Critical above","/h",500000,"E"],
  ["sizeW","Biggest message: Needs attention above","MB",1,"A"],["sizeC","Biggest message: Critical above","MB",30,"A"],
  ["recW","Records per message: Needs attention above","records",1000,"C"],["recC","Records per message: Critical above","records",50000,"C"],
  ["inprocW","In process at once: Needs attention above","msgs",50,"E"],["inprocC","In process at once: Critical above","msgs",200,"E"],
  ["ownRoad","Mass load per hour: Critical above (needs its own road)","/h",50000,"E"],["comfort","Comfort level: Fit up to this share of a capacity","%",70,"E"],
  ["slaMin","SLA 'within minutes' means at most","min",15,"E"],["slaHour","SLA 'within the hour' means at most","min",60,"E"]]},
 {g:"SAP BTP Integration Suite",items:[
  ["sapApimMB","API Management: non-streamed request limit","MB",10,"B"],["ciSoftMB","iFlow comfortable message size","MB",10,"E"],["ciGuardMB","iFlow sender body guard","MB",40,"B"],
  ["ciCap","iFlow capacity in process at once for this interface","msgs",50,"E"],["tThin","Thin iFlow step (only the target-facing call)","s/message",1,"E"],["slice","Metering slice","KB",250,"A"],["meterRatio","Metered weight per message: Adapt above","×",4,"E"],
  ["jmsGB","JMS queue storage available","GB",9,"A"],["quota","Monthly metered-message budget (0 = information only)","msgs",0,"—"]]},
 {g:"Azure (Premium tier)",items:[
  ["apimRps","APIM requests per second per unit (indicative)","req/s",1000,"E"],["apimUnits","APIM units","units",1,"—"],
  ["sbEntMB","Service Bus entity max message size (configured)","MB",1,"A"],["sbMaxMB","Service Bus Premium hard max","MB",100,"A"],
  ["sbMU","Service Bus messaging units","MU",1,"—"],["sbRate","Service Bus messages per second per MU (indicative)","msg/s",1000,"E"],
  ["laSoftMB","Logic App comfortable message size","MB",50,"E"],["laMaxMB","Logic App max message per action","MB",105,"A"],
  ["laSfCap","Logic App stateful: runs in parallel","runs",300,"E"],["laSlCap","Logic App stateless: runs in parallel","runs",1000,"E"],["laSlMax","Logic App stateless: max run duration","s",300,"A"],
  ["fnCap","Function App: executions in parallel","exec",1000,"E"]]},
 {g:"Solace / Advanced Event Mesh",items:[["solSoftMB","Comfortable message size","MB",10,"E"],["solMaxMB","Guaranteed message cap (service class)","MB",30,"A"],["solSpoolGB","Message spool","GB",50,"A"]]},
 {g:"Target delivery",items:[["batchMax","Records per small batch call ($batch)","records",1000,"C"],["massMax","Records above which only bulk or file works","records",50000,"C"]]},
 {g:"Message size calculation",items:[["nameLen","Average field name length","chars",12,"E"],["envB","Envelope per message","bytes",400,"E"],["idocSeg","IDoc segment record","bytes",1063,"A"],["idocCtl","IDoc control record","bytes",524,"A"],["idocFps","Fields per IDoc segment (approx.)","fields",25,"E"],["b64","Base64 growth for files in JSON or XML","×",1.37,"A"]]}
];
const SD={},SM={};SET_DEF.forEach(g=>g.items.forEach(([k,l,u,d,c])=>{SD[k]=d;SM[k]={l,u,d,c,g:g.g}}));
const SAVED=Object.assign({},SD);
try{const s=JSON.parse(localStorage.getItem("vpc_set")||"null");if(s)Object.keys(s).forEach(k=>{if(k in SAVED)SAVED[k]=+s[k]})}catch(e){}
const saveSet=()=>{try{const o={};Object.keys(SAVED).forEach(k=>{if(SAVED[k]!==SD[k])o[k]=SAVED[k]});localStorage.setItem("vpc_set",JSON.stringify(o))}catch(e){}};
const OV={}; /* this-run overrides */
const P=new Proxy({},{get:(t,k)=>k in OV?OV[k]:SAVED[k]});

const RAW={human:[0,0,0,0,0,0,.01,.04,.09,.13,.14,.12,.08,.10,.12,.11,.08,.05,.02,.01,0,0,0,0],
 app:[.01,.01,.01,.01,.01,.02,.03,.05,.07,.08,.08,.08,.07,.07,.08,.08,.07,.06,.04,.03,.02,.02,.01,.01],
 jobs:[.05,.30,.25,.10,.03,.02,.02,.02,.02,.02,.02,.02,.02,.02,.02,.02,.02,.02,.02,.02,.03,.03,.04,.06]};
const RAW_DEF=JSON.parse(JSON.stringify(RAW));
try{const c=JSON.parse(localStorage.getItem("vpc_curves")||"null");if(c)Object.keys(c).forEach(k=>{if(k in RAW&&Array.isArray(c[k])&&c[k].length===24)RAW[k]=c[k]})}catch(e){}
const CURVE={};function buildCurves(){Object.keys(RAW).forEach(k=>{const t=RAW[k].reduce((a,b)=>a+b,0)||1;CURVE[k]=RAW[k].map(v=>v/t)})}buildCurves();
const saveCurves=()=>{try{const o={};Object.keys(RAW).forEach(k=>{if(JSON.stringify(RAW[k])!==JSON.stringify(RAW_DEF[k]))o[k]=RAW[k]});localStorage.setItem("vpc_curves",JSON.stringify(o))}catch(e){}};
const peakShare=k=>Math.max(...CURVE[k]);
const WHO={human:"Human",app:"Application or process",jobs:"Scheduled jobs"};
const REG=[["AM","Americas"],["EM","EMEA"],["AP","Asia-Pacific"]];

/* ================= inputs ================= */
const DEF={touched:{},
 srcName:"",who:"human",countries:1,nL:0,nM:1,nS:0,regs:{AM:false,EM:true,AP:false},usersKnown:"yes",users:1000,refs:[{name:"",size:"M",users:500}],ovUsers:"",ovBig:"",ovBusy:"",acc:{},growth:1,mass:"no",massRec:300000,massWin:4,
 objName:"",content:"trans",sizeMode:"known",normBand:0,bigBand:1,attBand:1,fmtType:"json",struct:"hdr",hdrFields:20,lineFields:30,linesT:50,linesM:2000,att:false,multi:false,rpm:100,
 traffic:"cont",per:"day",freq:"day",globalKnown:"yes",typSize:"M",busyBand:1,busyExact:"",avgBand:-1,avgExact:"",dayF:1,
 midName:"",work:"w2",send:"one",tgtName:"",absorb:"few",sla:"min"};
let I=JSON.parse(JSON.stringify(DEF));
try{const s=JSON.parse(localStorage.getItem("vpc5_in")||"null");if(s){I=Object.assign(I,s);I.regs=Object.assign({},DEF.regs,s.regs||{});if(!Array.isArray(I.refs)||!I.refs.length)I.refs=JSON.parse(JSON.stringify(DEF.refs));I.acc=I.acc||{};}}catch(e){}
const saveIn=()=>{try{localStorage.setItem("vpc5_in",JSON.stringify(I))}catch(e){}};
let open=null;

/* ================= helpers ================= */
const fmt=v=>!isFinite(v)?"–":v>=1e6?(+(v/1e6).toFixed(v>=1e7?0:1))+"M":v>=1e4?Math.round(v/1e3)+"k":v>=1000?(+(v/1e3).toFixed(1))+"k":v>=10?Math.round(v)+"":v>=1?(+v.toFixed(1))+"":(+v.toFixed(2))+"";
const fmtB=b=>b>=1073741824?(+(b/1073741824).toFixed(1))+" GB":b>=1048576?(+(b/1048576).toFixed(1))+" MB":b>=1024?(+(b/1024).toFixed(b>=10240?0:1))+" KB":Math.round(b)+" B";
const fmtS=s=>s>=3600?(+(s/3600).toFixed(1))+" h":s>=60?(+(s/60).toFixed(1))+" min":(+s.toFixed(s<1?2:1))+" s";
const esc=t=>String(t||"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const MB=1048576;
const multi=()=>Math.max(1,+I.countries||1)>1;

/* ================= calculation ================= */
function groups(){const n=Math.max(1,+I.countries||1);if(n===1)return {L:0,M:1,S:0,n,ok:true};const L=+I.nL||0,M=+I.nM||0,S=+I.nS||0;return {L,M,S,n,ok:L+M+S===n};}
function weightTot(){const g=groups();return g.L*P.fL+g.M*P.fM+g.S*P.fS||1;}
function regionsSel(){const r=REG.filter(([k])=>I.regs[k]).map(([k])=>k);return r.length?r:["EM"];}
const SZN={L:"large",M:"medium",S:"small"};
function usersCalc(){
 const g=groups(),how=[];
 if(I.usersKnown==="yes"){const u=+I.users||0;return {u,est:false,how:[["Users or customers in scope","entered",u]]};}
 const refs=(I.refs||[]).filter(r=>+r.users>0);
 if(!refs.length)return {u:0,est:true,how:[["Users in scope","add at least one reference country","–"]]};
 /* per medium-equivalent from all references */
 const perMed=refs.map(r=>(+r.users)/P["f"+r.size]),avgMed=perMed.reduce((a,b)=>a+b,0)/perMed.length;
 refs.forEach(r=>how.push([`Reference: ${r.name?esc(r.name):"(no name)"}`,`${SZN[r.size]}, ${fmt(+r.users)} users`,+r.users]));
 let u=0;const cnt={L:g.L,M:g.M,S:g.S};
 ["L","M","S"].forEach(sz=>{if(!cnt[sz])return;const own=refs.filter(r=>r.size===sz);let per,src;
  if(own.length){per=own.reduce((a,r)=>a+(+r.users),0)/own.length;const mn=Math.min(...own.map(r=>+r.users)),mx=Math.max(...own.map(r=>+r.users));src=own.length>1?`average of ${own.length} ${SZN[sz]} references (range ${fmt(mn)}–${fmt(mx)})`:`from the ${SZN[sz]} reference`;}
  else{per=avgMed*P["f"+sz];src=`no ${SZN[sz]} reference: ${fmt(avgMed)} per medium equivalent × ${P["f"+sz]}`;}
  u+=cnt[sz]*per;how.push([`${cnt[sz]} ${SZN[sz]} countr${cnt[sz]>1?"ies":"y"}`,`${src} → ${fmt(per)} each`,cnt[sz]*per]);});
 how.push(["Estimated users in scope","sum of the size groups",u]);
 return {u,est:true,how};
}
function usersFinal(){const x=usersCalc();if(I.ovUsers!==""&&I.ovUsers!=null&&isFinite(+I.ovUsers)&&+I.ovUsers>0)return Object.assign(x,{u:+I.ovUsers,set:true});return x;}
function sizeCalc(){
 const v=P.valLen,nm=P.nameLen,f=I.fmtType,lines=I.struct==="hdr",hf=I.hdrFields,lf=I.lineFields;
 let pf=null,ov=0,hB,lB,env=P.envB,note;
 if(f==="json"){pf=nm+v+6;ov=3;note=`per field = name ${nm} + value ${v} + 6 (quotes, colon, comma)`;}
 else if(f==="xml"){pf=2*nm+5+v;ov=2*nm+5;note=`per field = 2 × name ${nm} + value ${v} + 5 (tags)`;}
 else if(f==="csv"){pf=v+1;ov=2;env=(lines?lf:hf)*(nm+1);note=`per field = value ${v} + 1 delimiter; envelope = header row`;}
 else note=`segments of ${P.idocSeg} bytes, ~${P.idocFps} fields each; control record ${P.idocCtl} bytes`;
 if(f==="idoc"){hB=Math.max(1,Math.ceil(hf/P.idocFps))*P.idocSeg;lB=Math.max(1,Math.ceil(lf/P.idocFps))*P.idocSeg;env=P.idocCtl;}else{hB=hf*pf+ov;lB=lf*pf+ov;}
 return {pf,hB,lB,env,note,lines,typ:env+hB+(lines?I.linesT*lB:0),big:env+hB+(lines?I.linesM*lB:0)};
}
/* size scale: edges in KB from settings */
function sizeEdges(){return [P.sz1,P.sz2*1024,P.sz3*1024,P.sz4*1024,P.sz5*1024];}
function sizeBands(){const e=sizeEdges(),f=kb=>kb>=1024?(+(kb/1024).toFixed(kb>=10240?0:1))+" MB":Math.round(kb)+" KB";
 return [`Under ${f(e[0])}`,`${f(e[0])} – ${f(e[1])}`,`${f(e[1])} – ${f(e[2])}`,`${f(e[2])} – ${f(e[3])}`,`${f(e[3])} – ${f(e[4])}`,`Over ${f(e[4])}`];}
function sizeRepKB(i){const e=sizeEdges();if(i<=0)return e[0]*0.4;if(i>=5)return e[4]*2;return Math.sqrt(e[i-1]*e[i]);}
function sizeBandOf(kb){const e=sizeEdges();let i=0;while(i<5&&kb>e[i])i++;return i;}
function sizes(){let typ,big;
 if(I.sizeMode==="calc"){const c=sizeCalc();typ=c.typ;big=c.big;}
 else{typ=sizeRepKB(+I.normBand||0)*1024;big=Math.max(typ,sizeRepKB(+I.bigBand||0)*1024);}
 const att=I.att?sizeRepKB(+I.attBand||0)*1024*((I.sizeMode==="calc"&&(I.fmtType==="json"||I.fmtType==="xml"))?P.b64:1):0;
 typ+=att;big+=att;
 let set=false;if(I.ovBig!==""&&I.ovBig!=null&&+I.ovBig>0){big=+I.ovBig*MB;set=true;typ=Math.min(typ,big);}
 return {typ,big,att,set};}
/* dynamic volume scale: messages-per-hour edges from throughput ÷ biggest message, capped by count edges */
function hourEdges(bigB){const b=Math.max(1,bigB);return [1,2,3].map(i=>Math.max(1,Math.min(P["tp"+i]*1073741824/b,P["cnt"+i])));}
function niceN(v){if(v<10)return Math.max(1,Math.round(v));const p=Math.pow(10,Math.floor(Math.log10(v)));const m=v/p;return (m<1.5?1:m<3.5?2:m<7.5?5:10)*p;}
function periodFactor(){const pk=peakShare(I.who);
 if(I.traffic==="batch")return Math.min(1,P.batchWin/60)*1; /* per run ≈ messages in the run window (hours) */
 return {hour:1,day:1/pk,week:P.weekDays/pk,month:P.workDays/pk}[I.per];}
function volEdges(bigB){const f=periodFactor();return hourEdges(bigB).map(e=>niceN(e*f));}
function volBands(bigB){const e=volEdges(bigB);return [`Under ${fmt(e[0])}`,`${fmt(e[0])} – ${fmt(e[1])}`,`${fmt(e[1])} – ${fmt(e[2])}`,`Over ${fmt(e[2])}`];}
function volRep(i,bigB){const e=volEdges(bigB);if(i<=0)return e[0]*0.4;if(i>=3)return e[2]*2;return Math.sqrt(e[i-1]*e[i]);}
function volValue(kind,bigB){const ex=I[kind+"Exact"];if(ex!==""&&ex!=null&&+ex>0)return +ex;const b=I[kind+"Band"];if(b===""||b==null||b<0)return null;return volRep(+b,bigB);}
function hourly(dailyPerMediumEq){const c=CURVE[I.who],H=new Array(24).fill(0),rs=regionsSel(),W=weightTot();
 rs.forEach(r=>{const off=P["o"+r],share=W/rs.length;for(let h=0;h<24;h++)H[h]+=share*dailyPerMediumEq*c[((h+off)%24+24)%24];});return H;}
const RUNS={month:1/21,week:1/5,day:1,day4:4,hour:24,min15:96};
const FREQN={month:"monthly",week:"weekly",day:"daily",day4:"4× a day",hour:"hourly",min15:"every 15 min"};
function calc(y3){
 const g=y3?(+I.growth||1):1,pk=peakShare(I.who),W=weightTot(),how=[],sz=sizes(),rpm=I.multi?Math.max(1,+I.rpm||1):1;
 const msgT=rpm*sz.typ,msgB=(rpm-1)*sz.typ+sz.big;
 const scopeAll=!multi()||I.globalKnown==="yes",f=scopeAll?1:P["f"+I.typSize],toScope=scopeAll?1:W/f;
 const who=scopeAll?(multi()?"all countries":"the country"):`one typical ${SZN[I.typSize]} country`;
 let busy=volValue("busy",msgB),avgIn=volValue("avg",msgB),R=0,avgH=0,H=new Array(24).fill(0),peakH=0,daily=0,naive=null;
 if(busy==null)busy=0;
 if(I.traffic==="batch"){
  const runs=I.freq==="month"?1/P.workDays:I.freq==="week"?1/P.weekDays:RUNS[I.freq],win=Math.min(P.batchWin,24*60/Math.max(1,runs))/60;
  const bScope=busy*toScope,aScope=(avgIn!=null?avgIn:busy)*toScope;
  how.push([`Busiest run, ${who}`,"entered",busy]);
  if(!scopeAll)how.push(["Busiest run, all countries",`÷ ${f} (its size) × country weight ${fmt(W)}`,bScope]);
  R=bScope/win;how.push(["Peak rate during a run",`busiest run ÷ run window ${fmt(win*60)} min`,R]);
  daily=aScope*runs;avgH=daily/24;how.push(["Per day",`average run × ${fmt(runs)} runs (${FREQN[I.freq]})`,daily],["Average hour","day ÷ 24",avgH]);
  for(let h=0;h<24;h++)H[h]=avgH;peakH=0;
 }else{
  let Dbusy,Davg;const per=I.per,days=per==="week"?P.weekDays:per==="month"?P.workDays:1;
  how.push([`Busiest ${per}, ${who}`,"entered",busy]);
  if(per==="hour"){Dbusy=busy/pk;how.push(["Busiest day",`÷ ${(pk*100).toFixed(0)}% (busiest-hour share of the ${WHO[I.who].toLowerCase()} curve)`,Dbusy]);Davg=avgIn!=null?avgIn*24:Dbusy;}
  else if(per==="day"){Dbusy=busy;Davg=avgIn!=null?avgIn:busy;}
  else{Dbusy=busy/days*I.dayF;how.push(["Busiest day",`÷ ${days} working days × ${I.dayF} (busiest day)`,Dbusy]);Davg=(avgIn!=null?avgIn:busy)/days;}
  if(avgIn!=null)how.push([`Average ${per}`,"entered",avgIn]);
  if(!scopeAll){how.push(["Busiest day, all countries",`÷ ${f} (its size) × country weight ${fmt(W)}`,Dbusy*toScope]);naive=(per==="hour"?busy:Dbusy*pk)/f*W;}
  Dbusy*=toScope;Davg*=toScope;
  if(scopeAll&&per==="hour"){const sh=hourly(1),m=Math.max(...sh)||1;H=sh.map(v=>v/m*busy);}else H=hourly(Dbusy/W);
  R=Math.max(...H);peakH=H.indexOf(R);daily=Davg;avgH=Davg/24;
  how.push(["Busiest hour",`curve${regionsSel().length>1?"s of "+regionsSel().length+" regions":""} summed per UTC hour, peak at ${peakH}:00 UTC`,R]);
  if(naive!=null&&regionsSel().length>1)how.push(["Plain multiplication would say","one country's busiest hour × country weight",naive]);
  how.push(["Average hour",`average day ÷ 24`,avgH]);
 }
 if(I.ovBusy!==""&&I.ovBusy!=null&&+I.ovBusy>0){R=+I.ovBusy;how.push(["Busiest hour (set by you)","override",R]);}
 R*=g;avgH*=g;daily*=g;if(g>1)how.push(["In 3 years",`× ${g}`,R]);
 how.push(["Peak per minute","busiest hour ÷ 60",R/60]);
 const msgs=R,recs=R*rpm,secs=P["t_"+I.work]||5,inproc=R/3600*secs;
 const massRate=(I.who!=="human"&&I.mass==="yes")?(+I.massRec||0)/Math.max(.25,+I.massWin||1):0;
 return {g,H:H.map(v=>v*g),peakH,R,msgs,recs,avg:avgH,daily,ratio:avgH>0?R/avgH:0,rpm,typ:sz.typ,big:sz.big,bigSet:sz.set,msgT,msgB,secs,inproc,massRate,how,users:usersFinal().u,edges:hourEdges(msgB)};
}

/* ================= part tags (scale only) ================= */
const TG={S:"Standard",N:"Needs attention",C:"Critical"};
function tagFor(k,c){
 if(k==="src"){let t="S";const u=usersFinal();let w=`${groups().n} countr${groups().n>1?"ies":"y"} in ${regionsSel().length} region${regionsSel().length>1?"s":""}${u.u?`, ${u.est&&!u.set?"estimated ":""}${fmt(u.u)} users in scope`:""}.`;
  if(+I.growth>=3){t="N";w+=` Growth ×${I.growth} in 3 years.`;}
  if(c.massRate){if(c.massRate>P.ownRoad){t="C";w+=` Mass load ≈ ${fmt(c.massRate)} per hour: needs its own road.`;}else{t=t==="C"?"C":"N";w+=` Mass load ≈ ${fmt(c.massRate)} per hour.`;}}
  if(multi()&&!groups().ok){t=t==="C"?"C":"N";w+=" Size groups don't add up to the number of countries.";}
  return {t,w,params:["fL","fM","fS","ownRoad"]};}
 if(k==="msg"){const m=c.msgB/MB;let t=m>P.sizeC?"C":m>P.sizeW?"N":"S",w=`Biggest message ≈ ${fmtB(c.msgB)} (${sizeBands()[sizeBandOf(c.msgB/1024)]}).`;
  if(c.rpm>P.recC){t="C";w+=` ${fmt(c.rpm)} records per message.`;}else if(c.rpm>P.recW&&t==="S"){t="N";w+=` ${fmt(c.rpm)} records per message.`;}
  return {t,w,params:["sz1","sz2","sz3","sz4","sz5","sizeW","sizeC","recW","recC"]};}
 if(k==="inf"){const e=c.edges,t=c.msgs>e[2]?"C":c.msgs>e[1]?"N":"S";return {t,w:`Busiest hour ≈ ${fmt(c.msgs)} messages; average ≈ ${fmt(c.avg)} per hour. For ${fmtB(c.msgB)} messages it starts to matter above ~${fmt(niceN(e[1]))} per hour.`,params:["tp1","tp2","tp3","cnt1","cnt2","cnt3","workDays","weekDays","batchWin"]};}
 if(k==="mid"){const t=c.inproc>P.inprocC?"C":c.inproc>P.inprocW?"N":"S";return {t,w:`${CPX[I.work]}: ≈ ${fmt(c.inproc)} messages in process at once (busiest hour × ${fmtS(c.secs)} each).`,params:["t_"+I.work,"inprocW","inprocC"]};}
 if(k==="del"){const d=delFit(c);return {t:d.z==="B"?"C":d.z==="A"?"N":"S",w:d.why,params:["batchMax","massMax"]};}
 if(k==="tgt"){const x=tgtCheck(c);return {t:x.z==="B"?"C":x.z==="A"?"N":"S",w:x.metric+" — "+x.why,params:["cap_"+I.absorb,"tgtT","smallF","bulkF","comfort","slaMin","slaHour"]};}
}
const CPX={w1:"Simple",w2:"Medium",w3:"Complex"};

/* ================= component checks ================= */
const CK=(comp,z,metric,why,formula,params,lens)=>({comp,z,metric,why,formula,params,lens:lens||"size"});
const NA=(comp,why,lens)=>CK(comp,"N","",why,"",[],lens);
function sizeCk(comp,b,soft,hard,kS,kH,hA,hB){const m=b/MB,z=m<=soft?"F":m<=hard?"A":"B";
 return CK(comp,z,`${fmtB(b)} biggest message vs ${soft} MB comfort / ${hard} MB cap`,z==="F"?"fits its size limit":z==="A"?hA:hB,`biggest message = ${fmtB(b)}\nFit ≤ ${soft} MB · Adapt ≤ ${hard} MB · Beyond above`,[kS,kH],"size");}
function capCk(comp,c,t,cap,kT,kC,hint,unit){const u=unit||"messages",inf=c.R/3600*t,drain=cap/t*3600;let z,why,clear=0;
 if(inf<=cap*P.comfort/100){z="F";why="has headroom at peak";}
 else if(inf<=cap){z="A";why="close to its limit at peak";}
 else if(c.avg<=drain){z="A";const back=(c.R-drain)*P.peakDur;clear=back/Math.max(1,drain-c.avg)*60;why=`can't keep up at peak; a queue holds ~${fmt(back)} ${u} and clears in ~${fmt(clear)} min`;}
 else{z="B";why="can't keep up even with the average: "+hint;}
 return Object.assign(CK(comp,z,`${fmt(inf)} in process at once vs capacity ${fmt(cap)} · handles ~${fmt(drain)} ${u}/h`,why,
  `in process at once = busiest hour ${fmt(c.R)} ${u} ÷ 3600 × ${fmtS(t)} = ${fmt(inf)}\nit can handle = ${fmt(cap)} ÷ ${fmtS(t)} × 3600 = ${fmt(drain)} ${u} per hour\nFit ≤ ${P.comfort}% of capacity · Adapt ≤ capacity, or the average ${fmt(c.avg)}/h ≤ what it handles · Beyond otherwise`,[kT,kC,"comfort","peakDur"].filter(Boolean),"volume"),{clear,drain});}
function delFit(c){const n=c.rpm,s=I.send;let z="F",why=`${({one:"One record per call",small:"Small batches",bulk:"Bulk or file"})[s]} matches ${fmt(n)} record${n>1?"s":""} per message`;
 if(n>P.massMax&&s!=="bulk"){z="B";why=`${fmt(n)} records per message need a bulk or file interface`;}
 else if(n>1&&s==="one"){z=n>P.batchMax?"B":"A";why=`${fmt(n)} records per message must be split again for one-per-call`;}
 else if(n>P.batchMax&&s==="small"){z="A";why=`${fmt(n)} records is more than one batch call (${fmt(P.batchMax)})`;}
 return CK("Delivery fit",z,`${fmt(n)} record${n>1?"s":""} per message, handed over as ${({one:"one per call",small:"small batches",bulk:"bulk or file"})[s]}`,why,`records per message = ${fmt(n)}\none per call: 1 · small batch: up to ${fmt(P.batchMax)} · bulk/file: any (practical OData limit ${fmt(P.massMax)})`,["batchMax","massMax"],"size");}
function tgtCheck(c){const f=I.send==="small"?P.smallF:I.send==="bulk"?P.bulkF:1,cap=P["cap_"+I.absorb];
 return capCk("Target capacity",{R:c.recs,avg:c.avg*c.rpm},P.tgtT/f,cap,"tgtT","cap_"+I.absorb,"agree more capacity, or hand over in batches","records");}
function slaCk(c,clearMin,batch){const lim={sec:0.1,min:P.slaMin,hour:P.slaHour,none:Infinity}[I.sla],lbl={sec:"within seconds",min:"within minutes",hour:"within the hour",none:"doesn't matter"}[I.sla];
 if(I.sla==="none")return NA("End-to-end SLA","no SLA set","volume");
 if(batch){const z=I.sla==="sec"?"B":I.sla==="min"?"A":"F";return CK("End-to-end SLA",z,lbl,z==="F"?"a scheduled run meets it":"batch runs can't deliver that fast","batch path: runs on a schedule, so delivery waits for the next run",["slaMin","slaHour"],"volume");}
 let z="F",why="met";if(clearMin>lim){z=clearMin>lim*4?"B":"A";why=`at peak, messages wait ~${fmt(clearMin)} min in a queue`;}else if(I.sla==="sec"&&c.ratio>4){z="A";why="peaks will queue for longer than seconds";}
 return CK("End-to-end SLA",z,lbl+(clearMin?` · queue clears in ~${fmt(clearMin)} min`:""),why,`SLA limit = ${fmt(lim)} min\nlongest queue clear time = ${fmt(clearMin)} min (from the capacity checks)`,["slaMin","slaHour"],"volume");}
function massCk(c,separate){
 if(!c.massRate)return NA("Mass loads","no mass loads","volume");
 if(separate)return CK("Mass loads","F",`${fmt(+I.massRec)} records in ${I.massWin} h`,"a good separate road for mass loads","bulk copy scales with data integration units",[],"volume");
 const z=c.massRate>P.ownRoad?"B":"A";return CK("Mass loads",z,`${fmt(c.massRate)} per hour on the event road`,z==="B"?"too much for the daily road: use a separate bulk road":"can share the road if run off-peak",`mass rate = ${fmt(+I.massRec||0)} ÷ ${+I.massWin||1} h = ${fmt(c.massRate)}/h\nBeyond above ${fmt(P.ownRoad)}/h`,["ownRoad"],"volume");}
function backlogCk(comp,bytes,capGB,kCap,note){
 if(bytes<=0)return NA(comp,"no backlog expected at peak","volume");
 const cap=capGB*1073741824,z=bytes<=cap*P.comfort/100?"F":bytes<=cap?"A":"B";
 return CK(comp,z,`peak backlog ≈ ${fmtB(bytes)} vs ${capGB} GB`,z==="F"?note:z==="A"?"backlog close to its storage limit":"backlog larger than its storage",`backlog = (busiest hour − what the iFlow handles) × ${P.peakDur} h × ${fmtB(c_msgT)} per message`,[kCap,"ciCap","peakDur"],"volume");}
let c_msgT=0;
function platforms(c){
 c_msgT=c.msgT;const PL=[];
 /* SAP BTP */
 const ci=capCk("Cloud Integration iFlow (doing the work)",c,c.secs,P.ciCap,"t_"+I.work,"ciCap","move the work upstream to a scalable platform");
 const ciThin=capCk("Cloud Integration iFlow (thin step only)",c,P.tThin,P.ciCap,"tThin","ciCap","group records before BTP");
 const w=Math.ceil(c.msgT/(P.slice*1024)),wb=Math.ceil(c.msgB/(P.slice*1024)),monthly=c.daily*P.workDays*w;
 const backlog=Math.max(0,(c.R-ci.drain)*P.peakDur)*c.msgT;
 PL.push({n:"SAP BTP Integration Suite",sub:"One shared tenant; the iFlow can't scale out for one interface.",cap:ci.drain,capTxt:"the iFlow doing the work",ch:[
  sizeCk("API Management",c.msgB,P.sapApimMB*0.5,P.sapApimMB,"sapApimMB","sapApimMB","enable streaming for large requests","above the non-streamed limit: streaming or claim check"),
  sizeCk("Cloud Integration iFlow (size)",c.msgB,P.ciSoftMB,P.ciGuardMB,"ciSoftMB","ciGuardMB","streaming design, avoid multicast and DOM parsing","above the sender guard: claim check or file path"),
  CK("Metering (per message)",w<=P.meterRatio?"F":"A",`each message billed as ${w} (biggest ${wb})`,w<=P.meterRatio?"normal cost per message":"cost per message rises: pass only what the target needs",`weight = ceil(message ${fmtB(c.msgT)} ÷ ${P.slice} KB) = ${w}\nFit ≤ ${P.meterRatio}`,["slice","meterRatio"],"size"),
  ci,ciThin,
  P.quota>0?CK("Metering (per month)",monthly<=P.quota?"F":"B",`≈ ${fmt(monthly)} billed messages per month vs budget ${fmt(P.quota)}`,monthly<=P.quota?"within budget":"over the monthly budget",`per month = average day ${fmt(c.daily)} × ${P.workDays} days × weight ${w}`,["quota","workDays"],"volume"):CK("Metering (per month)","I",`≈ ${fmt(monthly)} billed messages per month`,"for information (set a budget in settings to check it)",`per month = average day ${fmt(c.daily)} × ${P.workDays} days × weight ${w}`,["quota","workDays"],"volume"),
  backlogCk("JMS queues",backlog,P.jmsGB,"jmsGB","holds the iFlow backlog at peak")]});
 /* Azure */
 const rps=c.msgs/3600,azFn=capCk("Function App",c,c.secs,P.fnCap,"t_"+I.work,"fnCap","scale out the plan");
 const laSl=(()=>{const x=capCk("Logic App stateless",c,c.secs,P.laSlCap,"t_"+I.work,"laSlCap","scale out the plan");if(c.secs>P.laSlMax){x.z="B";x.why=`a run takes ${fmtS(c.secs)}, above the ${fmtS(P.laSlMax)} stateless limit: use stateful`;x.params.push("laSlMax");}else x.why+="; needs a durable queue in front";return x;})();
 PL.push({n:"Azure Integration Services (Premium)",sub:"Scales per interface: own plans and messaging units.",cap:Math.max(azFn.drain,laSl.drain),capTxt:"Function or stateless Logic App",ch:[
  sizeCk("Service Bus Premium (size)",c.msgB,P.sbEntMB,P.sbMaxMB,"sbEntMB","sbMaxMB","raise the entity's max message size","above the hard max: claim check"),
  sizeCk("Logic App (size)",c.msgB,P.laSoftMB,P.laMaxMB,"laSoftMB","laMaxMB","use chunking","above the action cap: blob + reference"),
  CK("API Management",rps<=P.apimRps*P.apimUnits*P.comfort/100?"F":rps<=P.apimRps*P.apimUnits?"A":"B",`${fmt(rps)} requests/s at peak vs ${fmt(P.apimRps*P.apimUnits)}`,"size not capped on Premium; rate checked per unit",`requests/s = ${fmt(c.msgs)} ÷ 3600\ncapacity = ${P.apimRps} × ${P.apimUnits} unit(s) (indicative)`,["apimRps","apimUnits","comfort"],"volume"),
  CK("Service Bus Premium (rate)",rps<=P.sbRate*P.sbMU*P.comfort/100?"F":rps<=P.sbRate*P.sbMU?"A":"B",`${fmt(rps)} msg/s vs ${fmt(P.sbRate*P.sbMU)}`,rps<=P.sbRate*P.sbMU?"within messaging-unit throughput":"add messaging units",`msg/s = ${fmt(c.msgs)} ÷ 3600\ncapacity = ${P.sbRate} × ${P.sbMU} MU (indicative; large messages lower it)`,["sbRate","sbMU","comfort"],"volume"),
  capCk("Logic App stateful",c,c.secs,P.laSfCap,"t_"+I.work,"laSfCap","scale out the plan, or use stateless for short runs"),
  laSl,azFn]});
 /* Solace */
 PL.push({n:"Solace / Advanced Event Mesh",sub:"Event broker; levels load in front of slower consumers.",cap:null,capTxt:"absorbs; drains at the consumer's pace",ch:[
  sizeCk("Message size",c.msgB,P.solSoftMB,P.solMaxMB,"solSoftMB","solMaxMB","close to the guaranteed message cap","above the cap: claim check"),
  backlogCk("Message spool",backlog,P.solSpoolGB,"solSpoolGB","absorbs the backlog in front of BTP"),
  massCk(c,false)]});
 /* ADF */
 const adfZ=I.who==="jobs"||I.traffic==="batch"?"F":(I.sla==="hour"||I.sla==="none")?"A":"B";
 PL.push({n:"Azure Data Factory",sub:"Batch and data path: scheduled runs, bulk loads.",cap:null,capTxt:"bulk; scales with data integration units",ch:[
  CK("Fit for this traffic",adfZ,I.traffic==="batch"?"scheduled batch":WHO[I.who],adfZ==="F"?"batch traffic suits a data path":adfZ==="A"?"continuous traffic must be collected into runs":"continuous traffic with a tight SLA is the wrong fit","ADF runs on schedules or triggers; it is not built for single messages",[],"volume"),
  slaCk(c,0,true),massCk(c,true)]});
 /* Target */
 const t=tgtCheck(c),clear=Math.max(ci.clear||0,t.clear||0);
 PL.push({n:"Target"+(I.tgtName?" — "+I.tgtName:""),sub:"The final speed limit.",cap:t.drain/Math.max(1,c.rpm),capTxt:"the target",ch:[delFit(c),t,slaCk(c,clear,false)]});
 PL.forEach(p=>{const real=p.ch.filter(x=>x.z==="F"||x.z==="A"||x.z==="B"),nb=real.filter(x=>x.z==="B").length,na=real.filter(x=>x.z==="A").length;p.v=nb?"B":na?"A":"F";
  p.lens={size:worstZ(p.ch.filter(x=>x.lens==="size")),volume:worstZ(p.ch.filter(x=>x.lens==="volume"))};});
 return PL;
}
function worstZ(a){const r=a.filter(x=>"FAB".includes(x.z));if(!r.length)return "N";return r.some(x=>x.z==="B")?"B":r.some(x=>x.z==="A")?"A":"F";}

/* ================= bands ================= */
const BANDS={
 L3:{n:"Busiest-hour rate",s:[["R1","≤ 1k/h"],["R2","1k–50k/h"],["R3","50k–500k/h"],["R4","> 500k/h"]],i:v=>v<=1000?0:v<=50000?1:v<=500000?2:3,why:"Rate decides whether single messages work, or records must be grouped or moved to a batch path."},
 L4:{n:"Peak vs average",s:[["Flat","< 3×"],["Peaky","3–10×"],["Burst","> 10×"]],i:v=>v<3?0:v<=10?1:2,why:"Uneven load needs a buffer in front of the slowest layer."},
 L1:{n:"Biggest message",s:[["S","≤ 250 KB"],["M","250 KB–1 MB"],["L","1–10 MB"],["XL","10–30 MB"],["XXL","> 30 MB"]],i:b=>{const m=b/MB;return m<=.25?0:m<=1?1:m<=10?2:m<=30?3:4},why:"Every layer has a size limit; the biggest message is the one that gets rejected."},
 C1:{n:"Records per message",s:[["Single","1"],["Set","2–1k"],["Bulk","1k–50k"],["Mass","> 50k"]],i:v=>v<=1?0:v<=1000?1:v<=50000?2:3,why:"Sets fit batch calls; bulk and mass need bulk or file interfaces."},
 P1:{n:"Work per record",s:[["W1","pass-through"],["W2","medium transformation"],["W3","heavy orchestration"]],i:()=>({w1:0,w2:1,w3:2})[I.work],why:"Work per record × rate = how many are in process at once."},
 D1:{n:"End-to-end SLA",s:[["Real-time","seconds"],["Async","minutes"],["Async","the hour"],["None","doesn't matter"]],i:()=>({sec:0,min:1,hour:2,none:3})[I.sla],why:"A tight SLA rules out batch paths and is hurt by queues at peak."},
 D3:{n:"Growth in 3 years",s:[["Stable","≤ 2×"],["Growing","2–5×"],["Explosive","> 5×"]],i:v=>v<=2?0:v<5?1:2,why:"Growth moves the interface across bands."}};

/* ================= diagram ================= */
const ST={src:{name:"Source",sub:"who · where · users · growth",x:110,y:215},inf:{name:"Influx",sub:"how many · when",x:305,y:215},msg:{name:"Message",sub:"how big",x:305,y:95},
 mid:{name:"Middleware",sub:"complexity",x:500,y:215},del:{name:"Delivery",sub:"how it's handed over",x:695,y:215},tgt:{name:"Target",sub:"capacity · SLA",x:890,y:215}};
const ORDER=["src","msg","inf","mid","del","tgt"];
const colT=t=>t?{S:"var(--fit)",N:"var(--ad)",C:"var(--be)"}[t]:"var(--idle)";
const bgT=t=>t?{S:"var(--fitbg)",N:"var(--adbg)",C:"var(--bebg)"}[t]:"var(--idlebg)";
const GLYPH={src:'<rect x="-20" y="-15" width="40" height="28" rx="4"/><path d="M-9 20h18M0 13v7"/><circle cx="-9" cy="-3" r="3.5"/><path d="M-1 -5h12M-1 1h8"/>',
 mid:'<g class="spin" id="gearG"><circle r="7"/><path d="M0 -19v6M0 13v6M-19 0h6M13 0h6M-13.4 -13.4l4.2 4.2M9.2 9.2l4.2 4.2M-13.4 13.4l4.2 -4.2M9.2 -9.2l4.2 -4.2"/></g>',
 tgt:'<ellipse cx="0" cy="-13" rx="16" ry="6"/><path d="M-16 -13v26c0 3.3 7.2 6 16 6s16-2.7 16-6v-26"/><path d="M-16 0c0 3.3 7.2 6 16 6s16-2.7 16-6"/>'};
function draw(){
 const c=calc(false),T=I.touched,tz=k=>T[k]?tagFor(k,c).t:null;
 const vol=Math.log10(Math.max(10,c.R)),thick=Math.min(30,6+(vol-1)*4),speed=Math.max(.35,3.2-(vol-1)*.45);
 const gearSpeed=Math.max(.6,8-Math.min(7,c.inproc/7)),msgScale=Math.min(1.6,.7+Math.log10(Math.max(1,c.msgB/1024))/5);
 let s="";
 const pipe=(k,x1,x2,y,th)=>{const col=colT(tz(k));return `<g class="hit" data-k="${k}" tabindex="0" role="button" aria-label="${ST[k].name}"><rect x="${x1}" y="${y-28}" width="${x2-x1}" height="56" fill="transparent"/>
  <line x1="${x1}" y1="${y}" x2="${x2}" y2="${y}" stroke="${bgT(tz(k))}" stroke-width="${th+10}" stroke-linecap="round"/><line class="ring" x1="${x1}" y1="${y}" x2="${x2}" y2="${y}" stroke="${col}" stroke-width="${th}" stroke-linecap="round" opacity=".35"/>
  <line class="dots" x1="${x1}" y1="${y}" x2="${x2}" y2="${y}" stroke="${col}" stroke-width="${Math.max(4,th*.45)}" stroke-dasharray="4 20" stroke-linecap="round" style="animation-duration:${speed}s"/>
  <path d="M${x2+4} ${y-9} L${x2+16} ${y} L${x2+4} ${y+9}" fill="${col}"/><text class="nodeLbl" x="${(x1+x2)/2}" y="${y+46}" style="font-size:15px">${ST[k].name}</text>
  <text class="nodeSub" x="${(x1+x2)/2}" y="${y+63}">${k==="inf"&&T.inf?fmt(c.msgs)+" msgs in the busiest hour":k==="del"&&T.del?({one:"one per call",small:"small batches",bulk:"bulk or file"})[I.send]:ST[k].sub}</text>
  ${tz(k)?`<text class="zoneTxt" x="${(x1+x2)/2}" y="${y+81}" fill="${col}">${TG[tz(k)]}</text>`:""}</g>`;};
 s+=pipe("inf",172,412,215,thick);s+=pipe("del",588,812,215,Math.max(6,thick*(I.send==="one"?1:I.send==="small"?.7:.5)));
 if(T.inf){const mx=Math.max(...c.H)||1;s+=`<g pointer-events="none">${c.H.map((v,h)=>`<rect x="${196+h*8}" y="${186-thick/2-26*v/mx}" width="6" height="${26*v/mx+1}" rx="1.5" fill="${h===c.peakH?colT(tz("inf")):"var(--idle)"}" opacity="${h===c.peakH?1:.6}"/>`).join("")}<text x="196" y="${186-thick/2-32}" style="font-size:10px;fill:var(--mute)">UTC 0h</text><text x="390" y="${186-thick/2-32}" text-anchor="end" style="font-size:10px;fill:var(--mute)">24h</text></g>`;}
 {const {x,y}=ST.msg,col=colT(tz("msg")),sc=msgScale;s+=`<line x1="${x}" y1="${y+30}" x2="${x}" y2="${T.inf?150:195-thick/2}" stroke="var(--idle)" stroke-dasharray="3 4"/>
  <g class="hit" data-k="msg" tabindex="0" role="button" aria-label="Message"><g transform="translate(${x} ${y}) scale(${sc})"><rect class="ring" x="-30" y="-20" width="60" height="40" rx="6" fill="${bgT(tz("msg"))}" stroke="${col}" stroke-width="3"/><path d="M-28 -17l28 20 28-20" fill="none" stroke="${col}" stroke-width="2.6" stroke-linejoin="round"/>
  ${c.rpm>1?`<rect x="-26" y="-26" width="60" height="40" rx="6" fill="none" stroke="${col}" stroke-width="1.6" opacity=".5"/><rect x="-22" y="-32" width="60" height="40" rx="6" fill="none" stroke="${col}" stroke-width="1.2" opacity=".3"/>`:""}
  ${I.att?`<g transform="translate(22 6)"><rect x="-8" y="-10" width="16" height="20" rx="2" fill="var(--card)" stroke="${col}" stroke-width="2"/><path d="M-4 -3h8M-4 2h8" stroke="${col}" stroke-width="1.6"/></g>`:""}</g>
  <text class="nodeLbl" x="${x-58*sc-8}" y="${y-2}" style="text-anchor:end;font-size:15px">${I.objName?esc(I.objName):"Message"}</text>
  <text class="nodeSub" x="${x-58*sc-8}" y="${y+15}" style="text-anchor:end">${T.msg?fmtB(c.msgB)+" biggest":"how big"}</text>
  ${tz("msg")?`<text class="zoneTxt" x="${x+40*sc+8}" y="${y+5}" fill="${col}" style="text-anchor:start">${TG[tz("msg")]}</text>`:""}</g>`;}
 ["src","mid","tgt"].forEach(k=>{const {x,y}=ST[k],t=tz(k),col=colT(t),nm=k==="src"?I.srcName:k==="mid"?I.midName:I.tgtName;
  const f=I.send==="small"?P.smallF:I.send==="bulk"?P.bulkF:1,fill=Math.min(1,c.recs/3600*P.tgtT/f/P["cap_"+I.absorb]);
  s+=`<g class="hit" data-k="${k}" tabindex="0" role="button" aria-label="${ST[k].name}"><circle class="ring" cx="${x}" cy="${y}" r="58" fill="${bgT(t)}" stroke="${col}" stroke-width="3.5"/>
  ${k==="tgt"?`<clipPath id="tclip"><circle cx="${x}" cy="${y}" r="55"/></clipPath><rect clip-path="url(#tclip)" x="${x-58}" y="${y+55-110*fill}" width="116" height="${110*fill}" fill="${col}" opacity=".18"/>`:""}
  <g transform="translate(${x} ${y-6})" class="glyph" style="stroke:${t?col:"var(--ink)"}">${GLYPH[k]}</g>
  <text class="nodeLbl" x="${x}" y="${y+86}">${ST[k].name}</text><text class="nodeSub" x="${x}" y="${y+103}">${k==="mid"&&T.mid?CPX[I.work]+(nm?" · "+esc(nm):""):nm?esc(nm):ST[k].sub}</text>
  ${t?`<text class="zoneTxt" x="${x}" y="${y+121}" fill="${col}">${TG[t]}</text>`:`<text x="${x}" y="${y+42}" text-anchor="middle" style="font-size:11px;fill:var(--mute)">tap</text>`}
  ${k==="src"&&c.massRate&&T.src?`<g transform="translate(${x+44} ${y-46})" class="pulse"><circle r="15" fill="var(--card)" stroke="${col}" stroke-width="2"/><text y="5" text-anchor="middle" style="font-size:14px;font-weight:800;fill:${col}">!</text></g>`:""}</g>`;});
 const svg=document.getElementById("svg");svg.innerHTML=s;
 const g=document.getElementById("gearG");if(g)g.style.animationDuration=gearSpeed+"s";
 svg.querySelectorAll(".hit").forEach(el=>{el.onclick=e=>{e.stopPropagation();openCard(el.dataset.k,el)};el.onkeydown=e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();openCard(el.dataset.k,el)}}});
 document.getElementById("hint").style.display=Object.keys(T).length?"none":"block";
 document.getElementById("runNote").classList.toggle("on",Object.keys(OV).length>0);
 renderResults(c);
}

/* ================= formula panel with inline parameters ================= */
let fxOpen={};
function fxHTML(id,formulaText,params,noBtn){
 const rows=(params||[]).filter((k,i,a)=>k&&k in SD&&a.indexOf(k)===i).map(k=>`<tr class="${k in OV?"ov":""}"><td>${SM[k].l}</td><td style="text-align:right"><input type="number" step="any" data-ov="${k}" value="${P[k]}"></td><td class="note">${SM[k].u}</td><td class="conf">${SM[k].c}</td></tr>`).join("");
 return `<div class="fx">${noBtn&&!fxOpen[id]?"":`<button class="fxBtn" data-fx="${id}">${fxOpen[id]?"▾ Hide formula":"▸ Show formula and assumptions"}</button>`}${fxOpen[id]?`<div class="fxBody"><span class="f">${formulaText}</span>${rows?`<table>${rows}</table><div class="note" style="margin-top:4px">Changes apply to this run only. Defaults live in Calculation settings.</div>`:""}</div>`:""}</div>`;}
function wireFx(root,rerender){
 root.querySelectorAll("[data-fx]").forEach(b=>b.onclick=e=>{e.stopPropagation();fxOpen[b.dataset.fx]=!fxOpen[b.dataset.fx];rerender();});
 root.querySelectorAll("[data-ov]").forEach(inp=>{inp.onclick=e=>e.stopPropagation();inp.addEventListener("change",()=>{const v=parseFloat(inp.value),k=inp.dataset.ov;if(isFinite(v)){if(v===SAVED[k])delete OV[k];else OV[k]=v;rerender();}});});
}

/* ================= cards ================= */
const chips=(id,label,opts,sm)=>`<div class="fld"><div class="lab"><span>${label}</span>${sm?`<span class="sm">${sm}</span>`:""}</div><div class="chips">${opts.map(o=>`<button class="chip${String(I[id])===String(o[0])?" on":""}" data-chip="${id}" data-v="${o[0]}"${typeof o[0]==="number"?' data-n="1"':""}>${o[1]}${o[2]?`<span class="sm"> · ${o[2]}</span>`:""}</button>`).join("")}</div></div>`;
const num=(id,label,unit,extra)=>`<div class="fld numrow"><label for="n_${id}" id="lab_${id}">${label}</label><span><input type="number" min="0" step="any" id="n_${id}" data-num="${id}" value="${I[id]}"> ${unit||""}${extra||""}</span></div>`;
const unitSel=(id,opts)=>` <select data-sel="${id}">${(opts||["KB","MB"]).map(o=>`<option value="${o[0]||o}"${I[id]===(o[0]||o)?" selected":""}>${o[1]||o}</option>`).join("")}</select>`;
const info=(id,label,ph)=>`<div class="fld infoRow"><div class="lab"><span>${label}<span class="infoTag">for info</span></span></div><input type="text" data-txt="${id}" value="${esc(I[id])}" placeholder="${ph}"></div>`;
const infoChips=(id,label,opts)=>`<div class="fld infoRow"><div class="lab"><span>${label}<span class="infoTag">for info</span></span></div><div class="chips">${opts.map(o=>`<button class="chip${I[id]===o[0]?" on":""}" data-chip="${id}" data-v="${o[0]}">${o[1]}</button>`).join("")}</div></div>`;
const check=(id,label)=>`<label class="chk"><input type="checkbox" data-chk="${id}" ${I[id]?"checked":""}> ${label}</label>`;
const perSel=id=>unitSel(id,[["hour","per hour"],["day","per day"],["month","per month"]]);
function estBox(key,label,valTxt,setByYou,fxId,ovUnit){
 const acc=I.acc&&I.acc[key],ovOpen=estOv[key];
 return `<div class="estW"><div class="estTop"><span class="estLbl">${setByYou?"Set by you":"Estimated"}</span><b>${label}: ${valTxt}</b>${acc&&!setByYou?'<span class="accd">✓ accepted</span>':""}</div>
 <div class="estAct">${!setByYou?`<button class="ea" data-acc="${key}">✓ Accept</button>`:""}<button class="ea" data-ovr="${key}">✎ ${setByYou?"Change":"Override"}</button>${setByYou?`<button class="ea" data-ovclr="${key}">↺ Use estimate</button>`:""}<button class="ea" data-fx="${fxId}">ƒ Formula</button></div>
 ${ovOpen?`<div class="numrow" style="margin-top:6px"><label>Your value</label><span><input type="number" min="0" step="any" data-ovin="${key}" value="${I[key]||""}"> ${ovUnit}</span></div>`:""}</div>`;}
let estOv={};
function cardBody(k){
 const c=calc(false);
 if(k==="src")return `<p class="why">The scope of the whole interface: who creates the data, where, and for how many users.</p>
  ${info("srcName","Source system","e.g. CRM, web shop")}
  ${chips("who","Who creates the data?",[["human","Human"],["app","Application or process"],["jobs","Scheduled jobs"]])}
  ${num("countries","How many countries at full rollout?","")}
  <div id="grpBox" ${multi()?"":"hidden"}><div class="fld"><div class="lab"><span>How many of them are…</span></div>
   <table class="grpTbl"><tr><td>Large</td><td><input type="number" min="0" data-num="nL" value="${I.nL}"></td><td>Medium</td><td><input type="number" min="0" data-num="nM" value="${I.nM}"></td><td>Small</td><td><input type="number" min="0" data-num="nS" value="${I.nS}"></td></tr></table><div class="warnTxt" id="grpWarn"></div></div>
   <div class="fld"><div class="lab"><span>Which regions?</span><span class="sm">pick one, two or all</span></div><div class="chips">${REG.map(([r,l])=>`<button class="chip${I.regs[r]?" on":""}" data-reg="${r}">${l}</button>`).join("")}</div></div></div>
  ${chips("usersKnown","Business users or customers in scope",[["yes","I know the total"],["no","Calculate from reference countries"]])}
  <div id="uYes" ${I.usersKnown==="yes"?"":"hidden"}>${num("users","Total users or customers","")}</div>
  <div id="uNo" ${I.usersKnown==="no"?"":"hidden"}><div class="refs">${(I.refs||[]).map((r,i)=>`<div class="refRow"><input type="text" data-ref="${i}" data-f="name" value="${esc(r.name)}" placeholder="Country (optional)"><select data-ref="${i}" data-f="size">${[["L","Large"],["M","Medium"],["S","Small"]].map(o=>`<option value="${o[0]}"${r.size===o[0]?" selected":""}>${o[1]}</option>`).join("")}</select><input type="number" min="0" data-ref="${i}" data-f="users" value="${r.users}" placeholder="users"><button class="rm" data-rmref="${i}" title="Remove">×</button></div>`).join("")}</div><button class="btn mini2" id="addRef">+ Add reference</button></div>
  ${chips("growth","Growth in 3 years?",[[1,"Same"],[2,"Doubles"],[3,"×3"],[5,"×5 or more"]])}
  <div id="massQ" ${I.who==="human"?"hidden":""}>${chips("mass","Any mass loads?",[["no","No"],["yes","Yes"]],"mass updates, initial loads")}
  <div id="massBox" ${I.mass==="yes"?"":"hidden"}>${num("massRec","Records in one mass load","records")}${num("massWin","Must finish within","hours")}</div></div>
  <div class="calcBox" id="cardCalc"></div>`;
 if(k==="msg"){const sb=sizeBands().map((l,i)=>[i,l]);return `<p class="why">How big one message gets. Only sizes that matter to a platform are on the scale.</p>
  ${info("objName","Business object","e.g. Sales order")}
  ${infoChips("content","Content",[["trans","Transaction data"],["master","Master data"],["doc","Document"]])}
  ${chips("sizeMode","Size",[["known","Pick on the scale"],["calc","Calculate it"]])}
  <div id="szKnown" ${I.sizeMode==="known"?"":"hidden"}>${chips("normBand","Normal message",sb)}${chips("bigBand","Biggest message",sb)}</div>
  <div id="szCalc" ${I.sizeMode==="calc"?"":"hidden"}>
   ${chips("fmtType","Format",[["json","JSON"],["xml","XML"],["csv","CSV"],["idoc","IDoc"]])}
   ${chips("struct","Structure",[["flat","One flat record"],["hdr","Header + lines"]])}
   ${num("hdrFields",I.struct==="hdr"?"Fields in the header":"Fields in the record","")}
   <div id="lineBox" ${I.struct==="hdr"?"":"hidden"}>${num("lineFields","Fields per line","")}${num("linesT","Lines, normal","")}${num("linesM","Lines, biggest","")}</div></div>
  ${check("att","Has an attachment")}<div id="attBox" ${I.att?"":"hidden"}>${chips("attBand","Attachment size",sb)}</div>
  ${check("multi","Several records per message")}<div id="multiBox" ${I.multi?"":"hidden"}>${num("rpm","Records per message","")}</div>
  <div class="calcBox" id="cardCalc"></div>`;}
 if(k==="inf"){const vb=volBands(c.msgB).map((l,i)=>[i,l]),unit=I.traffic==="batch"?"per run":"per "+I.per;
  return `<p class="why">How many messages arrive, and when. The scale adapts to your message size: bigger messages matter sooner.</p>
  ${chips("traffic","What kind of traffic?",[["cont","Continuous, as it happens"],["batch","Scheduled batch"]])}
  <div id="freqBox" ${I.traffic==="batch"?"":"hidden"}>${chips("freq","How often does it run?",[["month","Monthly"],["week","Weekly"],["day","Daily"],["day4","4× a day"],["hour","Hourly"],["min15","Every 15 min"]])}</div>
  <div id="perBox" ${I.traffic==="cont"?"":"hidden"}>${chips("per","Count messages per",[["hour","Hour"],["day","Day"],["week","Week"],["month","Month"]])}</div>
  <div id="gkQ" ${multi()?"":"hidden"}>${chips("globalKnown","Do you know the volume for all countries?",[["yes","Yes"],["no","No: use one typical country"]])}</div>
  <div id="typBox" ${multi()&&I.globalKnown==="no"?"":"hidden"}>${chips("typSize","Typical country size",[["L","Large"],["M","Medium"],["S","Small"]])}</div>
  ${chips("busyBand",`Busiest: messages ${unit}`,vb)}${num("busyExact","Or the exact number","")}
  ${chips("avgBand",`Average: messages ${unit}`,[[-1,"Not known"]].concat(vb))}${num("avgExact","Or the exact number","")}
  <div id="dayFBox" ${I.traffic==="cont"&&(I.per==="week"||I.per==="month")?"":"hidden"}>${chips("dayF","How much bigger is the busiest day?",[[1,"Normal"],[1.5,"×1.5"],[2,"×2"],[5,"×5"],[10,"×10"],[50,"×50"]],"month-end, campaigns")}</div>
  <div class="calcBox" id="cardCalc"></div>`;}
 if(k==="mid")return `<p class="why">How complex the processing is on the way.</p>
  ${info("midName","Flow name","e.g. Order enrichment")}
  ${chips("work","Complexity",[["w1","Simple","map and pass on"],["w2","Medium","transformation, lookups"],["w3","Complex","orchestration across systems"]])}
  <div class="calcBox" id="cardCalc"></div>`;
 if(k==="del")return `<p class="why">How data is handed to the target.</p>
  ${chips("send","Handed over as",[["one","One record per call"],["small","Small batches"],["bulk","Bulk or file"]])}
  <div class="calcBox" id="cardCalc"></div>`;
 if(k==="tgt")return `<p class="why">How much the target absorbs at once, and the end-to-end expectation.</p>
  ${info("tgtName","Target system","e.g. S/4HANA")}
  ${chips("absorb","How many calls can it handle at the same time?",[["one","One at a time"],["few","A few"],["dozens","Dozens"],["hundreds","Hundreds"]])}
  ${chips("sla","End-to-end SLA: how fast must a message arrive?",[["sec","Within seconds"],["min","Within minutes"],["hour","Within the hour"],["none","Doesn't matter"]])}
  <div class="calcBox" id="cardCalc"></div>`;
}
function cardCalc(k,c){
 const tg=tagFor(k,c),head=`<div class="tagBox ${tg.t}" style="margin-top:0"><span class="tg ${tg.t}">${TG[tg.t]}</span>${tg.w}</div>`;
 const tbl=rows=>`<table class="nums" style="margin-top:6px">${rows.map(r=>`<tr><td>${r[0]}<br><span class="note">${r[1]}</span></td><td>${typeof r[2]==="number"?fmt(r[2]):r[2]}</td></tr>`).join("")}</table>`;
 let body="",f="",params=tg.params;
 if(k==="src"){const u=usersFinal();if(I.usersKnown==="no")body=estBox("ovUsers","Users in scope",fmt(u.u),u.set,"card_src","users")+(fxOpen.card_src?tbl(u.how):"");
  f=`users in scope = ${I.usersKnown==="yes"?"entered":"per size group: average of its references, or (average per medium equivalent × size factor) when it has none"}\ncountry weight = large × ${P.fL} + medium × ${P.fM} + small × ${P.fS}${c.massRate?`\nmass rate = ${fmt(+I.massRec)} ÷ ${+I.massWin} h = ${fmt(c.massRate)}/h → Critical above ${fmt(P.ownRoad)}/h`:""}`;}
 if(k==="msg"){body=estBox("ovBig","Biggest message",`${fmtB(c.msgB)} · ${sizeBands()[sizeBandOf(c.msgB/1024)]}`,c.bigSet,"card_msg","MB");
  if(fxOpen.card_msg){if(I.sizeMode==="calc"){const d=sizeCalc();body+=tbl([["Envelope + "+(d.lines?"header":"record"),d.note,fmtB(d.env+d.hB)]].concat(d.lines?[["Per line","fields per line × per field",fmtB(d.lB)]]:[]).concat([["Normal message",d.lines?`${fmt(I.linesT)} lines`:"",fmtB(c.typ)],["Biggest message",d.lines?`${fmt(I.linesM)} lines`:"",fmtB(c.big)]]));params=params.concat(["valLen","nameLen","envB"].concat(I.fmtType==="idoc"?["idocSeg","idocCtl","idocFps"]:[]).concat(I.att?["b64"]:[]));}
   else body+=tbl([["Normal message","middle of the chosen band"+(I.att?" + attachment":""),fmtB(c.typ)],["Biggest message","middle of the chosen band"+(I.att?" + attachment":""),fmtB(c.big)]]);
   if(c.rpm>1)body+=tbl([["Grouped message",`(${fmt(c.rpm)} − 1) × normal + biggest`,fmtB(c.msgB)]]);}
  f=`biggest message = ${fmtB(c.msgB)} → Standard ≤ ${P.sizeW} MB · Needs attention ≤ ${P.sizeC} MB · Critical above\nrecords per message = ${fmt(c.rpm)} → Needs attention above ${fmt(P.recW)} · Critical above ${fmt(P.recC)}`;}
 if(k==="inf"){body=estBox("ovBusy","Busiest hour",`${fmt(c.msgs)} messages`,I.ovBusy!==""&&+I.ovBusy>0,"card_inf","messages/h")+(fxOpen.card_inf?tbl(c.how):"");
  const e=c.edges;f=`scale edges (per hour) = min(throughput limit ÷ biggest message ${fmtB(c.msgB)}, count limit)\n= ${fmt(niceN(e[0]))} · ${fmt(niceN(e[1]))} · ${fmt(niceN(e[2]))} messages per hour\nbusiest hour ${fmt(c.msgs)} → Standard ≤ ${fmt(niceN(e[1]))} · Needs attention ≤ ${fmt(niceN(e[2]))} · Critical above`;params=params.concat(["fL","fM","fS","oAM","oEM","oAP"]);}
 if(k==="mid"){f=`in process at once = busiest hour ${fmt(c.msgs)} ÷ 3600 × ${fmtS(c.secs)} = ${fmt(c.inproc)}\nStandard ≤ ${P.inprocW} · Needs attention ≤ ${P.inprocC} · Critical above`;}
 if(k==="del"){const d=delFit(c);f=d.formula;}
 if(k==="tgt"){const x=tgtCheck(c);f=x.formula;}
 return head+body+fxHTML("card_"+k,f,params,body.includes("estW"));
}
function openCard(k,el){
 open=k;I.touched[k]=1;saveIn();
 document.querySelectorAll(".pop").forEach(p=>p.remove());
 const pop=document.createElement("div");pop.className="pop"+(k==="msg"||k==="inf"||k==="src"?" wide":"");pop.id="pop";
 pop.innerHTML=`<button class="x" aria-label="Close">×</button><h3>${ST[k].name}</h3>${cardBody(k)}`;
 const stage=document.getElementById("stage");stage.appendChild(pop);
 const sr=stage.getBoundingClientRect(),er=el.getBoundingClientRect(),w=pop.offsetWidth;
 let left=er.left-sr.left+er.width/2-w/2;left=Math.max(8,Math.min(left,sr.width-w-8));
 pop.style.left=left+"px";pop.style.top=(er.bottom-sr.top+6)+"px";
 pop.addEventListener("click",e=>e.stopPropagation());pop.querySelector(".x").onclick=closeCard;
 const show=(i,c)=>{const e=document.getElementById(i);if(e)e.hidden=!c};
 pop.querySelectorAll("[data-num]").forEach(r=>r.addEventListener("input",()=>{const v=parseFloat(r.value),id=r.dataset.num;const opt=id==="busyExact"||id==="avgExact";I[id]=isFinite(v)&&v>=0?v:(opt?"":0);if(opt&&I[id]!==""){pop.querySelectorAll(`[data-chip="${id==="busyExact"?"busyBand":"avgBand"}"]`).forEach(x=>x.classList.remove("on"));}if(id==="countries"){show("grpBox",multi());show("gkQ",multi());}update();}));
 pop.querySelectorAll("[data-txt]").forEach(r=>r.addEventListener("input",()=>{I[r.dataset.txt]=r.value;update();}));
 pop.querySelectorAll("[data-chk]").forEach(r=>r.addEventListener("change",()=>{I[r.dataset.chk]=r.checked;show("attBox",I.att);show("multiBox",I.multi);update();}));
 pop.querySelectorAll("[data-reg]").forEach(b=>b.onclick=()=>{const r=b.dataset.reg;I.regs[r]=!I.regs[r];if(!REG.some(([x])=>I.regs[x]))I.regs[r]=true;b.classList.toggle("on",I.regs[r]);update();});
 pop.querySelectorAll("[data-ref]").forEach(inp=>inp.addEventListener(inp.tagName==="SELECT"?"change":"input",()=>{const i=+inp.dataset.ref,f=inp.dataset.f;I.refs[i][f]=f==="users"?(parseFloat(inp.value)||0):inp.value;update();}));
 pop.querySelectorAll("[data-rmref]").forEach(b=>b.onclick=()=>{I.refs.splice(+b.dataset.rmref,1);if(!I.refs.length)I.refs.push({name:"",size:"M",users:0});reopen();});
 const ar=document.getElementById("addRef");if(ar)ar.onclick=()=>{I.refs.push({name:"",size:"M",users:0});reopen();};
 pop.querySelectorAll("[data-chip]").forEach(b=>b.onclick=()=>{const id=b.dataset.chip;I[id]=b.dataset.n?+b.dataset.v:b.dataset.v;
  pop.querySelectorAll(`[data-chip="${id}"]`).forEach(x=>x.classList.toggle("on",x===b));
  if(id==="busyBand"){I.busyExact="";const x=document.getElementById("n_busyExact");if(x)x.value="";}
  if(id==="avgBand"){I.avgExact="";const x=document.getElementById("n_avgExact");if(x)x.value="";}
  if(id==="who")show("massQ",I.who!=="human");
  if(id==="mass")show("massBox",I.mass==="yes");
  if(id==="usersKnown"){show("uYes",I.usersKnown==="yes");show("uNo",I.usersKnown==="no");}
  if(id==="sizeMode"){show("szKnown",I.sizeMode==="known");show("szCalc",I.sizeMode==="calc");}
  if(id==="struct"){show("lineBox",I.struct==="hdr");document.getElementById("lab_hdrFields").textContent=I.struct==="hdr"?"Fields in the header":"Fields in the record";}
  if(["traffic","per","freq","globalKnown","typSize"].includes(id)){reopen();return;}
  update();});
 update();
}
function reopen(){const k=open;closeCard();draw();const el=document.querySelector(`.hit[data-k="${k}"]`);if(el)openCard(k,el);}
function closeCard(){open=null;document.querySelectorAll(".pop").forEach(p=>p.remove());document.getElementById("stage").style.minHeight="";}
function update(){
 saveIn();const pop=document.getElementById("pop");draw();if(!pop)return;
 {const st=document.getElementById("stage");if(pop.parentNode!==st)st.appendChild(pop);}
 const c=calc(false),cc=document.getElementById("cardCalc");
 if(cc){cc.innerHTML=cardCalc(open,c);wireFx(cc,update);
  cc.querySelectorAll("[data-acc]").forEach(b=>b.onclick=e=>{e.stopPropagation();I.acc[b.dataset.acc]=!I.acc[b.dataset.acc];update();});
  cc.querySelectorAll("[data-ovr]").forEach(b=>b.onclick=e=>{e.stopPropagation();estOv[b.dataset.ovr]=!estOv[b.dataset.ovr];update();});
  cc.querySelectorAll("[data-ovclr]").forEach(b=>b.onclick=e=>{e.stopPropagation();I[b.dataset.ovclr]="";estOv[b.dataset.ovclr]=false;update();});
  cc.querySelectorAll("[data-ovin]").forEach(inp=>{inp.onclick=e=>e.stopPropagation();inp.addEventListener("change",()=>{const v=parseFloat(inp.value);I[inp.dataset.ovin]=isFinite(v)&&v>0?v:"";update();});});}
 const gw=document.getElementById("grpWarn");if(gw){const g=groups();gw.textContent=multi()&&!g.ok?`Large + medium + small = ${g.L+g.M+g.S}, but ${g.n} countries are in scope.`:"";}
 setTimeout(()=>{const p=document.getElementById("pop");if(p&&getComputedStyle(p).position==="absolute")document.getElementById("stage").style.minHeight=(p.offsetTop+p.offsetHeight+16)+"px";},0);
}
document.addEventListener("click",e=>{if(open&&!e.target.closest(".pop")&&!e.target.closest(".hit"))closeCard();});
document.addEventListener("keydown",e=>{if(e.key==="Escape"){closeCard();closeSet();}});

/* ================= results ================= */
let expB=null;
const ZL={F:"Fit",A:"Adapt",B:"Beyond",N:"Not applicable",I:"Info"};
function compRow(x,x3,id){
 const params=x.params.filter((k,i,a)=>k&&k in SD&&a.indexOf(k)===i);
 return `<div class="crow${x.z==="N"?" na":""}"><div class="ch"><span class="zc ${x.z}">${ZL[x.z]}</span>${x3&&x3.z!==x.z&&"FAB".includes(x3.z)?`<span class="zc ${x3.z}" title="in 3 years">3y: ${ZL[x3.z]}</span>`:""}<span class="cn">${esc(x.comp)}</span><span class="cm">${x.metric?x.metric+" · ":""}${x.why}</span>${x.z!=="N"?`<button class="whyBtn" data-fx="${id}">Why</button>`:""}</div>
 ${fxOpen[id]&&x.z!=="N"?`<div class="fxBody"><span class="f">${x.formula}</span>${params.length?`<table>${params.map(k=>`<tr class="${k in OV?"ov":""}"><td>${SM[k].l}</td><td style="text-align:right"><input type="number" step="any" data-ov="${k}" value="${P[k]}"></td><td class="note">${SM[k].u}</td><td class="conf">${SM[k].c}</td></tr>`).join("")}</table><div class="note" style="margin-top:4px">Confidence: A official doc · B vendor KBA · C secondary · E empirical, to calibrate. Changes apply to this run only.</div>`:""}</div>`:""}</div>`;}
function renderResults(c){
 const any=Object.keys(I.touched).length,g3=(+I.growth||1)>1,c3=g3?calc(true):null;
 const PL=platforms(c),PL3=g3?platforms(c3):null;
 document.getElementById("platNote").textContent=any?`Each platform is checked twice: does the biggest message fit (size), and does the busiest hour fit (volume)?${g3?" A second chip shows the result in 3 years.":""} Tap “Why” for the facts and the calculation, and to change limits for this run.`:"Answer the parts of the flow above; the platform checks appear here.";
 const PV={F:"Fits",A:"Fits with changes",B:"Doesn't fit everywhere"};
 document.getElementById("plats").innerHTML=!any?"":PL.map((p,i)=>{
  const sec=(lens,title)=>{const rows=p.ch.map((x,j)=>[x,j]).filter(([x])=>x.lens===lens);if(!rows.length)return "";return `<div class="lensH">${title}</div>`+rows.map(([x,j])=>compRow(x,g3?PL3[i].ch[j]:null,`p${i}c${j}`)).join("");};
  const pct=c.msgs/p.cap*100,volLine=p.cap?`Busiest hour <b>${fmt(c.msgs)}</b> messages · ${esc(p.capTxt)} handles ~<b>${fmt(p.cap)}</b> per hour (${pct<=100?fmt(pct)+'% used':'×'+fmt(c.msgs/p.cap)+' its capacity'})`:`Busiest hour <b>${fmt(c.msgs)}</b> messages · ${esc(p.capTxt)}`;
  return `<div class="pcard"><h3>${esc(p.n)} <span class="zc ${p.v}">${PV[p.v]}</span></h3><div class="psub">${p.sub}</div>
  <div class="lensRow"><span>Size <span class="zc ${p.lens.size}">${ZL[p.lens.size]}</span></span><span>Volume <span class="zc ${p.lens.volume}">${ZL[p.lens.volume]}</span></span></div>
  <div class="volLine">${volLine}</div>${sec("size","Size: does the biggest message fit?")}${sec("volume","Volume: does the busiest hour fit?")}</div>`;}).join("");
 const pl=document.getElementById("plats");
 pl.querySelectorAll("[data-fx]").forEach(b=>b.onclick=e=>{e.stopPropagation();fxOpen[b.dataset.fx]=!fxOpen[b.dataset.fx];renderResults(calc(false));});
 pl.querySelectorAll("[data-ov]").forEach(inp=>{inp.onclick=e=>e.stopPropagation();inp.addEventListener("change",()=>{const v=parseFloat(inp.value),k=inp.dataset.ov;if(isFinite(v)){if(v===SAVED[k])delete OV[k];else OV[k]=v;update();}});});
 /* profile */
 const t=c,y=c3||c,h=t.how.map(x=>`${x[0]}: ${x[1]} = <b>${typeof x[2]==="number"?fmt(x[2]):x[2]}</b>`).join("<br>");
 const rows=[["Busiest hour (messages)","L3",fmt(t.msgs),fmt(y.msgs),t.msgs,y.msgs,h],["Peak vs average","L4","×"+fmt(t.ratio),"×"+fmt(y.ratio),t.ratio,y.ratio,`busiest ${fmt(t.msgs)} ÷ average ${fmt(t.avg)}`],
  ["Biggest message","L1",fmtB(t.msgB),fmtB(y.msgB),t.msgB,y.msgB,"From the Message card."],["Records per message","C1",fmt(t.rpm),fmt(y.rpm),t.rpm,y.rpm,I.multi?"Set on the Message.":"One per message."],
  ["Complexity","P1",CPX[I.work],"",0,0,`${CPX[I.work]} ≈ ${fmtS(t.secs)} per message (settings)`],
  ["In process at once","",fmt(t.inproc),fmt(y.inproc),null,null,`busiest hour ÷ 3600 × ${fmtS(t.secs)} (Little's law)`],
  ["End-to-end SLA","D1",({sec:"seconds",min:"minutes",hour:"the hour",none:"none"})[I.sla],"",0,0,"Set on the Target."],["Growth","D3","×"+(+I.growth||1),"",+I.growth||1,+I.growth||1,"Set on the Source."]];
 document.getElementById("prof").innerHTML=`<tr><th>Measure</th><th style="text-align:right">Today</th>${g3?'<th style="text-align:right">3 years</th>':""}<th>Band</th></tr>`+rows.map((r,i)=>{const B=r[1]?BANDS[r[1]]:null,bi=B?B.i(r[4]):null,by=B?B.i(r[5]):null;
  return `<tr><td>${r[0]}</td><td class="v">${r[2]}</td>${g3?`<td class="v">${r[3]}</td>`:""}<td>${B?`<span class="bd" data-b="${i}">${r[1]} ${B.s[bi][0]}</span>${g3&&by!==bi?` → <span class="bd" data-b="${i}">${B.s[by][0]}</span>`:""}`:`<span class="bd" data-b="${i}">how</span>`}</td></tr>`+
  (expB===i?`<tr class="expl"><td colspan="${g3?4:3}">${B?`<b>${r[1]} · ${B.n}</b><div class="scale">${B.s.map((s,j)=>`<span class="${j===bi?"on":""}">${s[0]} ${s[1]}</span>`).join("")}</div>`:""}<span class="f">${r[6]}</span>${B?`<span class="note">${B.why}</span>`:""}</td></tr>`:"");}).join("");
 document.querySelectorAll("#prof .bd").forEach(b=>b.onclick=e=>{e.stopPropagation();const i=+b.dataset.b;expB=expB===i?null:i;renderResults(calc(false));});
 window._sum=()=>{const L=[`Interface: ${I.objName||"(unnamed)"} · Source: ${I.srcName||"–"} · Flow: ${I.midName||"–"} · Target: ${I.tgtName||"–"}`];
  ORDER.filter(k=>I.touched[k]).forEach(k=>{const tg=tagFor(k,c);L.push(`${ST[k].name}: ${TG[tg.t]} — ${tg.w}`);});
  L.push("Platforms:");PL.forEach(p=>{L.push(`- ${p.n}: ${PV[p.v]} (size ${ZL[p.lens.size]}, volume ${ZL[p.lens.volume]})`);p.ch.filter(x=>x.z==="A"||x.z==="B").forEach(x=>L.push(`   · ${x.comp}: ${ZL[x.z]} (${x.why})`));});
  if(Object.keys(OV).length)L.push("Changed for this run: "+Object.keys(OV).map(k=>`${SM[k].l} = ${OV[k]}`).join("; "));return L.join("\n");};
}
document.getElementById("copy").onclick=async e=>{e.stopPropagation();try{await navigator.clipboard.writeText(window._sum());document.getElementById("copied").textContent="Copied";}catch(err){document.getElementById("copied").textContent="Copy not allowed here";}};
document.getElementById("runNote").onclick=e=>{e.stopPropagation();Object.keys(OV).forEach(k=>delete OV[k]);update();};

/* ================= settings modal ================= */
function openSet(){
 const bg=document.createElement("div");bg.className="modalBg";bg.id="setBg";
 bg.innerHTML=`<div class="modal"><div style="display:flex;justify-content:space-between;align-items:center"><h2>Calculation settings</h2><button class="btn" id="setClose">Done</button></div>
 <p class="note">The saved defaults behind every calculation: how answers turn into numbers, the boundaries for the scale tags, platform limits and daily curves. Changes made in a “Why” panel apply to one run only; changes here are saved in this browser. Confidence: A official doc · B vendor KBA · C secondary · E empirical, to calibrate. <button class="infoLink" data-guide="settings">ⓘ What each setting means and what the research says</button></p>
 ${SET_DEF.map(g=>`<h4>${g.g}</h4><table>${g.items.map(([k])=>`<tr id="sr_${k}"><td>${SM[k].l}</td><td style="text-align:right"><input type="number" step="any" id="s_${k}" value="${SAVED[k]}"></td><td class="note">${SM[k].u}</td><td class="note">default ${SD[k]}</td><td class="conf">${SM[k].c}</td></tr>`).join("")}</table>`).join("")}
 <h4>Daily curves (relative load per local hour, 0–23)</h4><p class="note" style="margin:2px 0 6px">24 values each, comma-separated, any scale.</p>
 ${Object.keys(RAW).map(k=>`<div class="fld" id="cr_${k}"><div class="lab"><span>${WHO[k]}</span><span class="sm" id="cpk_${k}"></span></div><input type="text" data-curve="${k}" value="${RAW[k].join(", ")}" style="width:100%;padding:6px 8px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink);font-family:ui-monospace,Menlo,monospace;font-size:12px"><svg viewBox="0 0 240 30" style="width:100%;height:30px;margin-top:4px" id="csv_${k}"></svg></div>`).join("")}
 <div style="margin-top:12px"><button class="btn" id="setReset">Reset to defaults</button></div></div>`;
 document.body.appendChild(bg);
 const curveChg=()=>Object.keys(RAW).some(k=>JSON.stringify(RAW[k])!==JSON.stringify(RAW_DEF[k]));
 const spark=k=>{const mx=Math.max(...CURVE[k])||1;document.getElementById("csv_"+k).innerHTML=CURVE[k].map((v,h)=>`<rect x="${h*10}" y="${30-28*v/mx}" width="8" height="${28*v/mx}" rx="1.5" fill="${v===mx?"var(--acc)":"var(--idle)"}"/>`).join("");document.getElementById("cpk_"+k).textContent=`peak ${(peakShare(k)*100).toFixed(1)}% at ${CURVE[k].indexOf(peakShare(k))}:00`;};
 const paint=()=>{Object.keys(SAVED).forEach(k=>document.getElementById("sr_"+k).classList.toggle("chg",SAVED[k]!==SD[k]));Object.keys(RAW).forEach(k=>document.getElementById("cr_"+k).classList.toggle("chg",JSON.stringify(RAW[k])!==JSON.stringify(RAW_DEF[k])));gearMark();};
 Object.keys(SAVED).forEach(k=>document.getElementById("s_"+k).addEventListener("input",e=>{const v=parseFloat(e.target.value);if(isFinite(v)){SAVED[k]=v;saveSet();paint();draw();}}));
 Object.keys(RAW).forEach(k=>{spark(k);const inp=bg.querySelector(`[data-curve="${k}"]`);inp.addEventListener("input",()=>{const a=inp.value.split(/[,;\s]+/).filter(x=>x!=="").map(Number);const ok=a.length===24&&a.every(x=>isFinite(x)&&x>=0)&&a.some(x=>x>0);inp.style.borderColor=ok?"var(--line)":"var(--be)";if(ok){RAW[k]=a;buildCurves();saveCurves();spark(k);paint();draw();}});});
 bg.onclick=e=>{if(e.target===bg)closeSet()};document.getElementById("setClose").onclick=closeSet;
 document.getElementById("setReset").onclick=()=>{Object.keys(SAVED).forEach(k=>{SAVED[k]=SD[k];document.getElementById("s_"+k).value=SAVED[k]});Object.keys(RAW).forEach(k=>{RAW[k]=RAW_DEF[k].slice();bg.querySelector(`[data-curve="${k}"]`).value=RAW[k].join(", ");});buildCurves();saveCurves();Object.keys(RAW).forEach(spark);saveSet();paint();draw();};
 paint();
}
function gearMark(){document.getElementById("gear").classList.toggle("mod",Object.keys(SAVED).some(k=>SAVED[k]!==SD[k])||Object.keys(RAW).some(k=>JSON.stringify(RAW[k])!==JSON.stringify(RAW_DEF[k])));}
function closeSet(){const b=document.getElementById("setBg");if(b)b.remove();}
document.getElementById("gear").onclick=e=>{e.stopPropagation();closeCard();openSet();};
gearMark();
document.getElementById("clr").onclick=e=>{e.stopPropagation();closeCard();closeSet();try{localStorage.removeItem("vpc5_in")}catch(err){}I=JSON.parse(JSON.stringify(DEF));Object.keys(OV).forEach(k=>delete OV[k]);fxOpen={};estOv={};expB=null;draw();};
draw();
</script>
<script>
/* ================= Guide (ground rules · formulas · how to) ================= */
const G_SRC={
 solace:["Solace service class options","https://docs.solace.com/Cloud/service-class-limits.htm"],
 solEnc:["Solace protocol metadata and payload encoding","https://docs.solace.com/API/Protocol-Metadata-Payload-Encoding.htm"],
 sapScope:["SAP Learning: system scope, Cloud Foundry","https://learning.sap.com/learning-journeys/developing-with-sap-integration-suite/understanding-system-scope-in-the-cloud-foundry-environment"],
 sapJms:["SAP blog: JMS asynchronous messaging with retry","https://community.sap.com/t5/integration-blog-posts/cloud-integration-configure-asynchronous-messaging-with-retry-using-jms/ba-p/13315669"],
 sapGuard:["SAP blog: guard against huge messages (2017)","https://blogs.sap.com/2017/06/29/how-to-guard-against-huge-messages/"],
 sapApim:["SAP KBA 3462229: APIM payload limit","https://userapps.support.sap.com/sap/support/knowledge/en/3462229"],
 sapNodes:["SAP KBA 3573749: runtime nodes on a tenant","https://userapps.support.sap.com/sap/support/knowledge/en/3573749"],
 sapAem:["SAP tutorial: AEM with Cloud Integration","https://developers.sap.com/tutorials/aem-integrate-cloud-integration-iflow.html"],
 sapKafka:["SAP blog: Kafka adapter","https://community.sap.com/t5/technology-blogs-by-sap/cloud-integration-what-you-need-to-know-about-the-kafka-adapter/bc-p/13495073"],
 laLim:["Logic Apps limits and configuration","https://learn.microsoft.com/azure/logic-apps/logic-apps-limits-and-config"],
 laHost:["Logic Apps host settings","https://learn.microsoft.com/azure/logic-apps/edit-app-settings-host-settings"],
 laBench:["Logic Apps Standard sustained processing benchmark","https://techcommunity.microsoft.com/blog/integrationsonazureblog/scaling-logic-apps-standard-%E2%80%93-sustained-event-processing-system/3876663"],
 laPrice:["Logic Apps Standard plans","https://learn.microsoft.com/azure/logic-apps/logic-apps-pricing"],
 fnSb:["Functions Service Bus bindings","https://learn.microsoft.com/azure/azure-functions/functions-bindings-service-bus"],
 fnPrem:["Functions Premium plan","https://learn.microsoft.com/azure/azure-functions/functions-premium-plan"],
 sbQ:["Service Bus quotas","https://learn.microsoft.com/azure/service-bus-messaging/service-bus-quotas"],
 sbPerf:["Service Bus Premium performance update (2024)","https://techcommunity.microsoft.com/blog/messagingonazureblog/service-bus-premium-sku-performance-update/4232600"],
 apimP:["Azure API Management pricing (capacity per unit)","https://azure.microsoft.com/en-us/pricing/details/api-management/"],
 apimL:["Azure API Management limits","https://learn.microsoft.com/azure/azure-resource-manager/management/azure-subscription-service-limits#api-management-limits"],
 adfL:["Azure Data Factory limits","https://learn.microsoft.com/azure/azure-resource-manager/management/azure-subscription-service-limits#data-factory-limits"],
 egL:["Event Grid quotas and limits","https://learn.microsoft.com/azure/event-grid/quotas-limits"],
 cisco:["Cisco: traffic analysis (busy hour)","https://www.cisco.com/c/en/us/td/docs/ios/solutions_docs/voip_solutions/TA_ISD.html"],
 ibmSap:["IBM/SAP user-based sizing","https://public.dhe.ibm.com/software/mktsupport/techdocs/erp_sap_user_based.pdf"],
 sapSizing:["SAP sizing white paper (users and workloads)","https://blogs.sap.com/2023/05/11/white-paper-sap-sizing-solution-based-on-users-and-workloads-part-1/"],
 div:["Diversity factor","https://en.wikipedia.org/wiki/Diversity_factor"],
 little:["Little's law, 50 years later","https://people.cs.umass.edu/~emery/classes/cmpsci691st/readings/OS/Littles-Law-50-Years-Later.pdf"],
 erlang:["Technion: Erlang B/C and QED staffing","https://serveng.technion.ac.il/files/Lectures/QED_lecture_Erlang_B_C.pdf"],
 kingman:["Kingman's formula","https://en.wikipedia.org/wiki/Kingman%27s_formula"],
 usl:["Gunther: Universal Scalability Law","https://ar5iv.arxiv.org/html/0808.1431"],
 lev:["Azure: queue-based load leveling","https://learn.microsoft.com/azure/architecture/patterns/queue-based-load-leveling"],
 retry:["AWS: limit retries","https://docs.aws.amazon.com/wellarchitected/latest/reliability-pillar/rel_mitigate_interaction_failure_limit_retries.md"],
 confl:["Confluent: choosing partitions","https://www.confluent.io/blog/how-choose-number-topics-partitions-kafka-cluster/"],
 rfc:["RFC 4648: Base64","https://www.rfc-editor.org/rfc/rfc4648"],
 idoc:["HCL: IDoc structural format","https://help.hcl-software.com/devops/test/hub/10.1/docs/topics/c_pack_sapr3_IDoc_Structural_Format.html"],
 adobe:["Adobe: Cyber Monday 2025","https://news.adobe.com/news/2025/12/adobe-cyber-monday-hits-record"]
};
const gL=k=>{const s=G_SRC[k];return s?`<a href="${s[1]}" target="_blank" rel="noopener">${s[0]}</a>`:""};
const gS=(...k)=>k.map(x=>{const s=G_SRC[x];return s?`<a href="${s[1]}" target="_blank" rel="noopener" title="${s[0]}">↗</a>`:""}).join(" ");
const cfB=c=>`<span class="cfB ${c}">${c}</span>`;
const gv=k=>{const v=P[k];return typeof v==="number"?(Math.abs(v)>=1000?v.toLocaleString("en-US"):v):v};

/* research values vs settings keys: [key, research value text, conf, verdict ok|diff|note, sources] */
const G_REV=[
 ["ciSoftMB","Keep 10 MB as a design choice; matches the 10 MB caps of BTP APIM and the smallest Solace classes","E","ok",["sapApim","solace"]],
 ["ciGuardMB","Confirmed: SOAP/IDoc sender body 40 MB, attachments 100 MB, HTTP 413 above","B","ok",["sapGuard"]],
 ["ciCap","No SAP figure exists. Replace by concurrent processes per channel × worker nodes (read nodes from the tenant; 2 assumed)","B/E","diff",["sapJms","sapNodes"]],
 ["jmsGB","Confirmed 9 GB default; up to 30 GB, 30→100 queues, 150→500 transactions","A","ok",["sapScope"]],
 ["sbRate","Queue ≈ 6,800 msg/s per MU · topic with 1 subscription ≈ 5,000 · topic with 5 subscriptions ≈ 1,600 (1 KB messages, up to 4 MU)","B","diff",["sbPerf"]],
 ["sbEntMB","1 MB is the HTTP message and batch limit, not an entity limit; AMQP message up to 100 MB; queue/topic size up to 80 GB","A","diff",["sbQ"]],
 ["sbMaxMB","Confirmed 100 MB, over AMQP only; throughput drops above 1 MB","A","ok",["sbQ"]],
 ["apimRps","By tier: Basic ≈ 1,000 · Standard ≈ 2,500 · Premium ≈ 4,000 req/s per unit (Microsoft: for information only); no figure for v2","A*","diff",["apimP"]],
 ["laSoftMB","Keep; equals the 52,428,800-byte chunk size","A/E","ok",["laHost"]],
 ["laMaxMB","100 MiB = 104,857,600 bytes without chunking; 1 GB with chunking (not all connectors)","A","ok",["laLim"]],
 ["laSfCap","No source. Use trigger concurrency (max 100 when on) and throughput ≈ 90 actions/s per WS3 instance, ≈ 100k actions/min per storage account","A/B","diff",["laLim","laBench"]],
 ["laSlCap","No source. Same model as stateful; stateless For-each and Until limited to 100 items","A/E","diff",["laLim"]],
 ["laSlMax","Confirmed 5 minutes","A","ok",["laLim"]],
 ["fnCap","16 concurrent Service Bus calls per instance (docs also say × cores) × instances (≤ 100)","A/E","diff",["fnSb","fnPrem"]],
 ["solMaxMB","Class-dependent: 10 MB on E100/E250 (older E1K), 30 MB on E1K (later) and above","A","diff",["solace"]],
 ["solSpoolGB","50 GB is the E250 default only: E100 25 · E1K 200 · E5K 400 · E10K 600 · E50K 800 · E100K 1,000 GB","A","diff",["solace"]],
 ["fL","No source for ×3 / ×1 / ×0.3: keep as fallback; prefer a volume driver per country (users, orders)","E","note",[]],
 ["comfort","Replace one comfort % by a utilisation target by pool size: 60–70% (≤ 4 consumers), 70–80% (5–20), 85–90% (> 50); lower for bursty traffic (Kingman)","A/C","diff",["erlang","kingman"]],
 ["b64","Confirmed: 4/3 × 78/76 = 1.368 (with MIME line breaks)","A","ok",["rfc"]],
 ["idocSeg","Segment data ≤ 1,000 bytes (C); 1,063 / 524-byte record lengths widely quoted, not confirmed on an SAP page","C/E","note",["idoc"]],
 ["envB","JSON/XML per-field coefficients and envelope have no source: measure on real messages","E","note",[]]
];

const G_CH=[
 {id:"start",grp:"Use",t:"Start here",h:()=>`
  <h3>Start here</h3><p class="gLead">The calculator places one asynchronous interface on a scale of ranges and checks it against each platform component. It is not platform sizing: it tells you whether the chosen components fit this interface, and where the line is.</p>
  <div class="cardRow">
   <div class="miniCard"><b>1 · Describe</b><p>Tap each part of the flow: source, message, influx, middleware, delivery, target. Answer what you know.</p></div>
   <div class="miniCard"><b>2 · Read the scale</b><p>Each part gets a tag: Standard, Needs attention or Critical. No platform is named yet.</p></div>
   <div class="miniCard"><b>3 · Read the verdicts</b><p>Below the flow, each platform component is checked for size and for volume: Fit, Adapt, Beyond, Not suitable, Not applicable.</p></div>
   <div class="miniCard"><b>4 · Trace and adjust</b><p>Every estimate shows its formula. Accept, override, or change a factor for this run. Saved defaults live in ⚙ Calculation settings.</p></div>
  </div>
  <h4>Two questions, kept apart</h4>
  <table><tr><th>Question</th><th>Where</th><th>Labels</th></tr>
  <tr><td>Is the scale of this part concerning?</td><td>On the flow diagram</td><td><span class="tg S">Standard</span><span class="tg N">Needs attention</span><span class="tg C">Critical</span></td></tr>
  <tr><td>Does this platform component fit?</td><td>Platform evaluation</td><td>Fit · Adapt · Beyond · Not suitable · Not applicable</td></tr></table>
  <h4>Confidence labels</h4>
  <table><tr><td>${cfB("A")}</td><td>Official vendor documentation</td></tr><tr><td>${cfB("B")}</td><td>Vendor blog, KBA or published benchmark</td></tr><tr><td>${cfB("C")}</td><td>Community or secondary source</td></tr><tr><td>${cfB("E")}</td><td>Empirical or assumed: measure on your tenant and calibrate</td></tr></table>
  <div class="callout">New to the ideas behind it? Open <button class="infoLink" data-deck="1">🎞 Concepts</button>, a 15-slide introduction for architects and designers.</div>`},
 {id:"use",grp:"Use",t:"How to use, card by card",h:()=>`
  <h3>How to use, card by card</h3><p class="gLead">Each question is asked once. An answer given in one card is reused everywhere else. Dimmed fields are information only and don't change any number.</p>
  <h4>Source · who, where, how many</h4><ul>
   <li><b>Who creates the data</b>: Human, Application or process, Scheduled jobs. Picks the daily curve used for the busiest hour, and whether the mass-load question appears.</li>
   <li><b>Countries at full rollout</b>, grouped Large / Medium / Small, and the <b>regions</b> (Americas, EMEA, Asia-Pacific). They weight the regional curves.</li>
   <li><b>Users</b>: the global number if known, or estimated from one or more reference countries (name, size, users). Shown as <i>Estimated users in scope</i>: accept, override, or open the formula.</li>
   <li><b>Growth in 3 years</b> and, for applications or jobs, a <b>mass load</b> (records and window), checked as its own road.</li></ul>
  <h4>Message · how big</h4><ul>
   <li>Give the size directly as bands (normal and biggest), or derive it from format (JSON, XML, CSV, IDoc), fields and lines.</li>
   <li>Files inside JSON/XML are grown by base64. <i>One message carries</i> is information only.</li>
   <li>Records per message: only when one message carries several records (a set, a bulk).</li></ul>
  <h4>Influx · how many, when</h4><ul>
   <li>Nature first: <b>continuous</b> or <b>scheduled batch</b> (how often, and the run window).</li>
   <li>Period: per hour, day, week or month. With more than one country, the <b>global</b> volume is asked; if unknown, a typical volume for one country of a size group is extrapolated.</li>
   <li>Busiest and average on a scale whose edges move with message size (10 messages matter at 50 MB; thousands don't at 10 KB). Exact numbers can be typed.</li>
   <li>A daily, weekly or monthly figure is turned into a busiest hour by the daily curves and time zones: see Formulas.</li></ul>
  <h4>Middleware · complexity</h4><ul><li>Simple, Medium or Complex. Turned into seconds per message (settings) and so into messages in process at once.</li></ul>
  <h4>Delivery · how it's handed over</h4><ul><li>One by one, small batches ($batch) or bulk/file. Decides how the target is called and how fast it absorbs records.</li></ul>
  <h4>Target · capacity and SLA</h4><ul><li>How many calls the target takes at the same time, and the <b>end-to-end SLA</b>: seconds, minutes, the hour, or doesn't matter.</li></ul>
  <h4>Results</h4><ul>
   <li>Each platform card has two sections: <b>Size</b> (does the biggest message fit?) and <b>Volume</b> (does the busiest hour fit?).</li>
   <li><b>Why</b> opens the facts, the formula and the limits; change any factor there for this run. <i>Changed for this run · reset</i> undoes it.</li>
   <li><b>Copy summary</b> puts a text version on the clipboard.</li></ul>`},
 {id:"profile",grp:"Use",t:"Workload profile",h:()=>`
  <h3>Workload profile</h3><p class="gLead">The profile is the interface's fingerprint: one band per dimension. Bands are fixed ranges whose edges sit where real platform limits sit, so two architects with the same answers get the same profile.</p>
  <table><tr><th>Code</th><th>Dimension</th><th>Bands</th><th>Why it matters</th></tr>
  ${Object.entries(BANDS).map(([k,b])=>`<tr><td><b>${k}</b></td><td>${b.n}</td><td>${b.s.map(s=>`${s[0]} <span class="note">${s[1]}</span>`).join("<br>")}</td><td>${b.why}</td></tr>`).join("")}
  <tr><td>—</td><td>In process at once</td><td>number</td><td>Messages being worked on at the same moment: busiest hour ÷ 3600 × seconds per message. Compared with each component's parallel capacity.</td></tr></table>
  <h4>How to read it</h4><ul>
   <li><b>Today</b> is your answers; <b>3 years</b> appears when growth is above ×1.</li>
   <li>Tap a band to see the calculation behind it.</li>
   <li>One band in a high range is a design point. Several high bands together (big and frequent, or frequent and complex) are where designs flip.</li>
   <li>The profile has no platform in it. Platform fit is judged only in the evaluation above it.</li></ul>`},
 {id:"formulas",grp:"Method",t:"Formulas",h:()=>`
  <h3>Formulas</h3><p class="gLead">Every formula the calculator uses, with its inputs and assumptions. Values shown are your current settings.</p>
  <div class="fBox"><div class="fh">Users in scope</div><code>known: global users
estimated (one reference): users_ref ÷ weight_ref × Σ(countries_g × weight_g)
estimated (several): average users per medium-equivalent across references, × Σ(countries_g × weight_g)</code>
   <p class="ex">Weights: large ×${gv("fL")}, medium ×${gv("fM")}, small ×${gv("fS")} ${cfB("E")}. Users only help derive volume, never the reverse.</p></div>
  <div class="fBox"><div class="fh">Message size</div><code>JSON: envelope + Σ fields × (name ${gv("nameLen")} + value ${gv("valLen")} + 6) bytes
XML:  envelope + Σ fields × (2 × name + value + 5)
CSV:  header row + lines × Σ (value + 1)
IDoc: control ${gv("idocCtl")} B + segments × ${gv("idocSeg")} B  (≈ ${gv("idocFps")} fields per segment)
files inside JSON/XML: × ${gv("b64")} (base64)</code>
   <p class="ex">Envelope ${gv("envB")} B. Run twice: normal and biggest message. Size bands start at ${gv("sz1")} KB, where size starts to matter on any platform.</p></div>
  <div class="fBox"><div class="fh">From a period to the busiest hour</div><code>per day   → busiest hour = day × peak share of the curve
per week  → day = week ÷ ${gv("weekDays")} working days
per month → day = month ÷ ${gv("workDays")} working days
batch     → busiest hour = messages per run ÷ run window (${gv("batchWin")} min) × 60</code>
   <p class="ex">Peak share = the busiest hour of the combined daily curve (see Statistics). A busiest-day factor (×1.5 … ×50) multiplies the day first.</p></div>
  <div class="fBox"><div class="fh">Global busiest hour</div><code>for each UTC hour h: load(h) = Σ_regions weight_r × curve(h − offset_r)
peak share = max_h load(h) ÷ Σ_h load(h)</code>
   <p class="ex">Offsets: Americas ${gv("oAM")} h, EMEA +${gv("oEM")} h, Asia-Pacific +${gv("oAP")} h. The calculator also shows the plain "one country × N" figure for comparison.</p></div>
  <div class="fBox"><div class="fh">Volume scale edges</div><code>edge_i (per hour) = min(throughput_i ÷ biggest message, count_i)
throughput edges ${gv("tp1")} / ${gv("tp2")} / ${gv("tp3")} GB/h · count edges ${gv("cnt1")} / ${gv("cnt2")} / ${gv("cnt3")} per hour
converted to the chosen period: day = hour ÷ peak share; week = day × ${gv("weekDays")}; month = day × ${gv("workDays")}</code></div>
  <div class="fBox"><div class="fh">In process at once (Little's law)</div><code>in process = busiest hour ÷ 3600 × seconds per message</code>
   <p class="ex">Seconds per message by complexity: simple ${gv("t_w1")} s, medium ${gv("t_w2")} s, complex ${gv("t_w3")} s ${cfB("E")}. It is an average: bursts push it higher for short moments.</p></div>
  <div class="fBox"><div class="fh">Capacity verdict</div><code>drain (msgs/h) = capacity ÷ seconds per message × 3600
Fit    : in process ≤ ${gv("comfort")}% of capacity
Adapt  : in process ≤ capacity, or average rate ≤ drain (a queue holds the peak)
Beyond : otherwise
clear time (min) = backlog ÷ (drain − average) × 60</code>
   <p class="ex">Not suitable: the component is built for another traffic shape (e.g. continuous traffic on ADF). Not applicable: the check doesn't apply (e.g. no mass load).</p></div>
  <div class="fBox"><div class="fh">Growth</div><code>years to breach = ln(limit ÷ today) ÷ ln(1 + yearly growth)
3-year value = today × growth factor</code></div>
  <div class="callout warn">Under review: the single comfort % is planned to become a utilisation target that depends on pool size and burstiness. See <button class="infoLink" data-go="review">Under review</button>.</div>`},
 {id:"stats",grp:"Method",t:"Traffic statistics",h:()=>{const sp=k=>{const mx=Math.max(...CURVE[k])||1;return `<svg viewBox="0 0 240 46">${CURVE[k].map((v,h)=>`<rect x="${h*10}" y="${44-42*v/mx}" width="8" height="${42*v/mx}" rx="1.5" fill="${v===mx?"var(--acc)":"var(--idle)"}"/>`).join("")}</svg>`;};return `
  <h3>Traffic statistics</h3><p class="gLead">How the shape of traffic over a day and a year is assumed, and what the research supports.</p>
  <h4>Daily curves in use</h4><div class="spark">${Object.keys(CURVE).map(k=>`<div><b>${WHO[k]}</b>${sp(k)}<span class="note">busiest hour ${(peakShare(k)*100).toFixed(1)}% of the day at ${CURVE[k].indexOf(peakShare(k))}:00 local</span></div>`).join("")}</div>
  <p class="note">Editable in ⚙ Calculation settings (24 values per curve). Changing a curve changes every busiest-hour estimate.</p>
  <table><tr><th>Rule</th><th>Value</th><th>Conf.</th><th>Source</th></tr>
  <tr><td>Busiest-hour share, office-hours traffic</td><td>15–20% of the day (17% used in planning); floor 1/8 = 12.5%</td><td>${cfB("B")}</td><td>${gS("cisco")}</td></tr>
  <tr><td>Business-day shape</td><td>Two humps: 10–11 and 14–15 local; SAP peak window 08–18</td><td>${cfB("B")}</td><td>${gS("cisco","ibmSap")}</td></tr>
  <tr><td>24-hour consumer events</td><td>≈ 5–10% in the busiest hour (Cyber Monday 2025 ≈ 6.7%)</td><td>${cfB("E")}</td><td>${gS("adobe")}</td></tr>
  <tr><td>Batch</td><td>busiest hour = run ÷ window (hours)</td><td>${cfB("A")}</td><td>arithmetic</td></tr>
  <tr><td>Design day</td><td>Size for the 4th-busiest day of the month (ITU-T E.492), not the absolute maximum</td><td>${cfB("A")}</td><td>${gS("cisco")}</td></tr>
  <tr><td>Peak-day factors</td><td>Cyber Monday ≈ 3.4× an average season day; Prime Day 1.4–1.6× baseline. Month-end 2–3× is common practice, not sourced</td><td>${cfB("E")}</td><td>${gS("adobe")}</td></tr>
  <tr><td>Working days</td><td>≈ 21 per month; SAP regional defaults 200 (Europe) / 250 (Americas) / 300 (Asia-Pacific) per year</td><td>${cfB("B")}</td><td>${gS("ibmSap")}</td></tr></table>
  <h4>Global aggregation across time zones</h4>
  <p>Shift each region's curve by its UTC offset, weight it, sum per UTC hour, take the maximum. The ratio global peak ÷ sum of regional peaks is the <b>coincidence factor</b> (1 ÷ diversity factor), a method from electrical load planning ${cfB("A")} ${gS("div")}.</p>
  <table><tr><th>Mix</th><th>Busiest hour, share of global day</th><th>Coincidence</th></tr>
  <tr><td>One region</td><td>≈ 12–20%</td><td>1.0</td></tr><tr><td>Three equal regions</td><td>≈ 4–5%</td><td>≈ 0.33–0.4</td></tr><tr><td>Europe-heavy (60 / 30 / 10)</td><td>≈ 9–12%</td><td>≈ 0.6–0.8</td></tr></table>
  <p class="note">Worked values ${cfB("E")}. Central jobs released at one moment break the spreading: count them with coincidence 1.</p>
  <h4>From users to messages</h4>
  <p>SAP user classes: <b>Low 10, Medium 120, High 360</b> dialog steps per hour, sized on concurrent users ${cfB("B")} ${gS("ibmSap")}. SAP Quick Sizer is ±20% and excludes interfaces ${gS("sapSizing")}.</p>
  <code class="fCode">messages/h ≈ concurrent users × steps/h ÷ steps per document (5–15, E) × fan-out (3–6, E)</code>
  <p class="note">Expect ±50%. Prefer a known volume or a reference country.</p>
  <h4>Bursts inside the hour</h4>
  <p>For random (Poisson) arrivals the busiest minute is ≈ λ + 3.1√λ (λ = average per minute): ×1.1 at 1,000/min, ×2.1 at 10/min ${cfB("A")}. Batch releases don't smooth out with volume: treat them as a block of N arriving at once.</p>`}},
 {id:"queue",grp:"Method",t:"Capacity and queues",h:()=>`
  <h3>Capacity and queues</h3><p class="gLead">The queueing rules behind Fit, Adapt and Beyond. The maths is textbook-solid ${cfB("A")}; the platform parameters are not.</p>
  <div class="fBox"><div class="fh">Little's law ${cfB("A")} ${gS("little")}</div><code>in process L = arrival rate λ × time in system W
consumers needed c = ⌈λ × S ÷ target utilisation⌉</code><p class="ex">Holds for any arrival pattern, as an average. Use a high-percentile processing time (p95) for a cautious sizing.</p></div>
  <div class="fBox"><div class="fh">Utilisation and waiting (Erlang C, Kingman) ${cfB("A")} ${gS("erlang","kingman")}</div><code>wait ≈ (c_a² + c_s²) ÷ 2 × ρ ÷ (1 − ρ) × S</code><p class="ex">ρ = utilisation, c = variability of arrivals and service. From 80% to 90% utilisation the wait more than doubles. Large pools can run hotter than small ones (square-root staffing).</p>
   <table><tr><th>Consumers in the pool</th><th>Target utilisation</th></tr><tr><td>≤ 4</td><td>60–70%</td></tr><tr><td>5–20</td><td>70–80%</td></tr><tr><td>&gt; 50</td><td>85–90%</td></tr></table><p class="ex">Bands ${cfB("C")}; lower them for bursty traffic.</p></div>
  <div class="fBox"><div class="fh">Peaks, backlog and drain ${cfB("B")} ${gS("lev")}</div><code>backlog after a peak B = (λ_peak − μ) × T_peak
time to clear = B ÷ (μ − λ_average)      only if μ > λ_average
oldest message age ≈ B ÷ μ                (check against expiry / TTL)
spool needed ≈ B × message size × 1.5–2</code><p class="ex">A queue lets you size for the average, never for less than the average.</p></div>
  <div class="fBox"><div class="fh">Chains ${cfB("A")} ${gS("retry")}</div><code>chain throughput = min over steps (capacity_i)
end-to-end time = Σ (processing_i + queue wait_i)
attempts with r retries = (1 − p^(r+1)) ÷ (1 − p)</code><p class="ex">Retry at one layer only: retries at several layers multiply load.</p></div>
  <div class="fBox"><div class="fh">More consumers is not always faster (USL) ${cfB("A")} ${gS("usl")}</div><code>C(N) = N ÷ (1 + σ(N − 1) + κN(N − 1))      peak at N* = √((1 − σ) ÷ κ)</code><p class="ex">σ (contention) and κ (coherence) have to be measured per platform with 4–6 load points.</p></div>
  <div class="fBox"><div class="fh">Growth ${gS("confl")}</div><code>design capacity = peak × (1 + g)^H ÷ target utilisation
headroom years  = ln(capacity × ρ ÷ peak) ÷ ln(1 + g)</code></div>`},
 {id:"rules",grp:"Ground rules",t:"Platform ground rules",h:()=>`
  <h3>Platform ground rules</h3><p class="gLead">Limits and capacity facts per component, from vendor sources. Researched November 2026. SAP publishes limits but no throughput; Azure publishes ceilings and blog benchmarks.</p>
  <h4>SAP BTP Integration Suite</h4>
  <table><tr><th>Component</th><th>Ground rule</th><th>Conf.</th><th>Src</th></tr>
  <tr><td>Tenant</td><td>Content 500 MB · message processing log 35 GB · runtime DB 35 GB · disk 4 GB</td><td>${cfB("A")}</td><td>${gS("sapScope")}</td></tr>
  <tr><td>Sender size guard</td><td>SOAP/IDoc: body 40 MB, attachments 100 MB (0 = unlimited); HTTP 413 above</td><td>${cfB("B")}</td><td>${gS("sapGuard")}</td></tr>
  <tr><td>Parallelism</td><td>Effective = concurrent processes per channel × worker nodes. JMS sender default 1 process. HTTP-type senders process on the receiving worker</td><td>${cfB("B")}</td><td>${gS("sapJms","sapKafka")}</td></tr>
  <tr><td>Worker nodes</td><td>Not published; differs per tenant; read from the runtime nodes view</td><td>${cfB("A")}</td><td>${gS("sapNodes")}</td></tr>
  <tr><td>JMS</td><td>9 GB / 30 queues / 150 transactions by default; up to 30 GB / 100 / 500. Messages kept 90 days by default</td><td>${cfB("A")}</td><td>${gS("sapScope","sapJms")}</td></tr>
  <tr><td>AEM sender</td><td>SMF consumer on a queue; consumers = parallel consumers × worker nodes; exclusive queue = one active flow</td><td>${cfB("A")}/${cfB("E")}</td><td>${gS("sapAem")}</td></tr>
  <tr><td>Metering</td><td>1 billable message = 250 KB slice (cost, not capacity)</td><td>${cfB("C")}</td><td></td></tr>
  <tr><td>API Management</td><td>10 MB non-streamed; streaming off by default; rate limits are your own policies</td><td>${cfB("A")}</td><td>${gS("sapApim")}</td></tr></table>
  <h4>Solace / Advanced Event Mesh service classes ${gS("solace")}</h4>
  <table><tr><th>Class</th><th class="n">Connections</th><th class="n">Spool</th><th class="n">Max message</th><th class="n">Queues</th><th class="n">REST out / RDPs</th></tr>
  ${[["E100","100","25 GB","10 MB","100","1,000 / 200"],["E250","250","50 GB","10 MB","250","1,000 / 200"],["E1K","1,000","200 GB","10 → 30 MB","1,000","1,000 / 200"],["E5K","5,000","400 GB","30 MB","5,000","7,500 / 500"],["E10K","10,000","600 GB","30 MB","10,000","7,500 / 500"],["E50K","50,000","800 GB","30 MB","50,000","22,500 / 1,500"],["E100K","100,000","1,000 GB","30 MB","100,000","22,500 / 1,500"]].map(r=>`<tr><td><b>${r[0]}</b></td>${r.slice(1).map(x=>`<td class="n">${x}</td>`).join("")}</tr>`).join("")}</table>
  <ul><li>SMF and AMQP count against the enterprise connection pool; MQTT, web messaging and incoming REST against the IoT pool. One client = one connection ${cfB("A")}.</li>
  <li>All protocols are translated to SMF; guaranteed messages above ≈ 30 MB are discarded; compression is SMF-only ${cfB("A")} ${gS("solEnc")}.</li>
  <li>Consumer parallelism is a queue setting (max consumers). No message-rate figure is published per class: measure ${cfB("E")}.</li>
  <li>REST delivery to an iFlow: ceiling ≈ REST outgoing connections ÷ iFlow response time ${cfB("E")}.</li></ul>
  <h4>Azure (Premium)</h4>
  <table><tr><th>Component</th><th>Ground rule</th><th>Conf.</th><th>Src</th></tr>
  <tr><td>Logic Apps Standard plans</td><td>WS1 1 vCPU / 3.5 GB · WS2 2 / 7 · WS3 4 / 14; 20–100 instances by region; scaling 1→100 takes 25–50 min</td><td>${cfB("A")}</td><td>${gS("laPrice","laLim")}</td></tr>
  <tr><td>Logic Apps throughput</td><td>≈ 100k actions/min per storage account (≤ 32 accounts); benchmark ≈ 90 actions/s per WS3 instance</td><td>${cfB("A")}/${cfB("B")}</td><td>${gS("laLim","laBench")}</td></tr>
  <tr><td>Logic Apps concurrency</td><td>Trigger concurrency max 100 (cannot be undone), 200 waiting runs; For-each 20 default / 50 max</td><td>${cfB("A")}</td><td>${gS("laLim")}</td></tr>
  <tr><td>Logic Apps size and time</td><td>100 MiB per message (1 GB chunked) · HTTP 225 s · stateless run 5 min · stateful 90 days</td><td>${cfB("A")}</td><td>${gS("laLim")}</td></tr>
  <tr><td>Logic App behind APIM</td><td>Calling a Request trigger via the APIM REST API is throttled at 56 calls / 5 min: use the callback URL</td><td>${cfB("A")}</td><td>${gS("laLim")}</td></tr>
  <tr><td>Functions Premium</td><td>EP1/2/3 = 1/2/4 cores; Service Bus trigger 16 concurrent calls, 8 sessions, batch 1,000; ≤ 100 instances; HTTP 230 s</td><td>${cfB("A")}</td><td>${gS("fnSb","fnPrem")}</td></tr>
  <tr><td>Service Bus Premium</td><td>1/2/4/8/16 MU; 100 MB over AMQP, 1 MB over HTTP and per batch; queues up to 80 GB; 5,000 AMQP connections</td><td>${cfB("A")}</td><td>${gS("sbQ")}</td></tr>
  <tr><td>Service Bus throughput</td><td>Per MU, 1 KB: queue ≈ 6,800 msg/s · topic + 1 sub ≈ 5,000 · topic + 5 subs ≈ 1,600; ≈ linear to 4 MU</td><td>${cfB("B")}</td><td>${gS("sbPerf")}</td></tr>
  <tr><td>API Management</td><td>≈ req/s per unit: Basic 1,000 · Standard 2,500 · Premium 4,000 (indicative); buffered body 500 MiB classic, <b>2 MiB on v2</b></td><td>${cfB("A")}*</td><td>${gS("apimP","apimL")}</td></tr>
  <tr><td>Data Factory</td><td>10,000 concurrent runs per factory; For-each 20/50; 4–256 DIU; self-hosted IR ≤ 4 nodes. Batch only, never per message</td><td>${cfB("A")}</td><td>${gS("adfL")}</td></tr>
  <tr><td>Event Grid</td><td>Basic topics 5,000 events/s or 5 MB/s, 1 MB per event. Carry signals, not payloads</td><td>${cfB("A")}</td><td>${gS("egL")}</td></tr></table>
  <p class="note">* Microsoft marks the APIM figures "for information only".</p>`},
 {id:"settings",grp:"Ground rules",t:"Settings explained",h:()=>{const rv={};G_REV.forEach(r=>rv[r[0]]=r);return `
  <h3>Settings explained</h3><p class="gLead">Every parameter in ⚙ Calculation settings: what it does, its current and default value, its confidence, and what the research says where it differs.</p>
  <div class="callout">Settings are saved in this browser only. A change in a <b>Why</b> panel applies to one run; a change in ⚙ settings becomes your default. Rows marked <span class="diff">review</span> differ from the research.</div>
  ${SET_DEF.map(g=>`<h4>${g.g}</h4><table><tr><th>Parameter</th><th class="n">Now</th><th class="n">Default</th><th>Conf.</th><th>Research</th></tr>${g.items.map(([k])=>{const r=rv[k];return `<tr><td>${SM[k].l}</td><td class="n">${gv(k)} <span class="note">${SM[k].u}</span></td><td class="n">${SD[k]}</td><td>${SM[k].c==="—"?"—":cfB(SM[k].c)}</td><td>${r?`<span class="${r[3]==="ok"?"ok":r[3]==="diff"?"diff":""}">${r[3]==="ok"?"confirmed":r[3]==="diff"?"review":"note"}</span> ${r[1]} ${gS(...r[4])}`:""}</td></tr>`}).join("")}</table>`).join("")}`}},
 {id:"review",grp:"Ground rules",t:"Under review",h:()=>`
  <h3>Under review</h3><p class="gLead">What the November 2026 research says about the values the calculator uses today. Nothing here has been applied yet: it waits for an architecture decision.</p>
  <table><tr><th>Setting</th><th class="n">Now</th><th>Research</th><th>Conf.</th></tr>
  ${G_REV.map(r=>`<tr><td>${SM[r[0]]?SM[r[0]].l:r[0]}</td><td class="n">${gv(r[0])} <span class="note">${SM[r[0]]?SM[r[0]].u:""}</span></td><td><span class="${r[3]==="ok"?"ok":r[3]==="diff"?"diff":""}">${r[3]==="ok"?"Confirmed":r[3]==="diff"?"Change":"Note"}</span> · ${r[1]} ${gS(...r[4])}</td><td>${r[2]}</td></tr>`).join("")}</table>
  <h4>To measure on your tenant</h4>
  <table><tr><th>Measure</th><th>Why</th></tr>
  ${[["Cloud Integration worker nodes and threads per worker","Multiplier for all iFlow parallelism; not published"],["iFlow msg/s and processing time (p50/p95) for reference flows: pass-through, mapping, IDoc","No SAP benchmark exists; calibrates seconds per message"],["JMS per-message size cap; transactions used per consumer per node","Old 10 MB value unverified; transaction budget is inferred"],["AEM sender parallel-consumer default and max","Not published"],["Solace msg/s and MB/s per class; max consumers per queue","Not on the class page"],["BTP API Management TPS and max streamed size","Not published"],["HTTP sender max body; iFlow → backend timeout","Unverified"],["Service Bus throughput above 1 KB, above 4 MU, topics with real filters","Benchmark covers 1 KB, ≤ 4 MU only"],["Azure APIM v2 req/s per unit; Premium with your policies","v2 unpublished; Premium indicative"],["Logic App actions/s per WS1/WS2/WS3 for your workflow mix","Only a blog-derived ≈ 90 actions/s per WS3"],["Functions effective Service Bus concurrency per EP size","Docs contradict: 16 vs 16 × cores"],["Scalability (σ, κ) per platform; busiest-hour share and burstiness from minute-level logs","Drive utilisation targets and consumer caps"],["IDoc and JSON/XML bytes per field on real messages","Size coefficients unsourced"]].map(r=>`<tr><td>${r[0]}</td><td>${r[1]}</td></tr>`).join("")}</table>`},
 {id:"sources",grp:"Ground rules",t:"Sources",h:()=>`
  <h3>Sources</h3><p class="gLead">Pages opened during the research (November 2026).</p>
  <ul>${Object.keys(G_SRC).map(k=>`<li>${gL(k)}</li>`).join("")}</ul>
  <p class="note">Framework document: Interface Workload Envelope Framework (section 8 holds the middleware research).</p>`}
];

let gCur="start";
function openGuide(ch){
 closeCard&&closeCard();closeSet&&closeSet();closeGuide();
 if(ch)gCur=ch;
 const bg=document.createElement("div");bg.className="gDrawerBg";bg.id="gBg";
 let nav="",lastG="";G_CH.forEach((c,i)=>{if(c.grp!==lastG){nav+=`<div class="grp">${c.grp}</div>`;lastG=c.grp;}nav+=`<button data-ch="${c.id}" class="${c.id===gCur?"on":""}"><span class="num">${i+1}</span><span class="t">${c.t}</span></button>`;});
 bg.innerHTML=`<div class="gDrawer" role="dialog" aria-label="Guide"><div class="gHead"><div><h2>Guide</h2><p class="note">Ground rules, formulas, statistics and how to use the calculator</p></div><div style="display:flex;gap:8px;align-items:center"><input class="gSearch" id="gQ" placeholder="Search the guide"><button class="btn" data-deck="1">🎞 Concepts</button><button class="btn" id="gClose">Close</button></div></div>
 <div class="gBody"><nav class="gNav">${nav}</nav><div class="gMain" id="gMain"></div></div></div>`;
 document.body.appendChild(bg);
 bg.onclick=e=>{if(e.target===bg)closeGuide();};
 document.getElementById("gClose").onclick=closeGuide;
 bg.querySelectorAll("[data-ch]").forEach(b=>b.onclick=()=>gShow(b.dataset.ch));
 document.getElementById("gQ").addEventListener("input",e=>gSearch(e.target.value));
 bg.addEventListener("click",e=>{const d=e.target.closest("[data-deck]");if(d){e.stopPropagation();openDeck();}const g=e.target.closest("[data-go]");if(g){e.stopPropagation();gShow(g.dataset.go);}});
 gShow(gCur);
}
function gShow(id){gCur=id;const c=G_CH.find(x=>x.id===id)||G_CH[0];const m=document.getElementById("gMain");if(!m)return;m.innerHTML=c.h();m.scrollTop=0;document.querySelectorAll(".gNav [data-ch]").forEach(b=>b.classList.toggle("on",b.dataset.ch===id));}
function gSearch(q){q=q.trim().toLowerCase();const m=document.getElementById("gMain");if(!q){gShow(gCur);return;}
 const hits=[];G_CH.forEach(c=>{const d=document.createElement("div");d.innerHTML=c.h();const txt=d.textContent.replace(/\s+/g," ");const i=txt.toLowerCase().indexOf(q);if(i>=0)hits.push({c,s:txt.slice(Math.max(0,i-70),i+110)});});
 m.innerHTML=`<h3>Search: “${q.replace(/</g,"&lt;")}”</h3>`+(hits.length?hits.map(h=>`<div class="fBox"><div class="fh"><button class="infoLink" data-go="${h.c.id}">${h.c.t} →</button></div><p class="ex">…${h.s.replace(/</g,"&lt;")}…</p></div>`).join(""):`<p class="note">No match.</p>`);}
function closeGuide(){const b=document.getElementById("gBg");if(b)b.remove();}
function openDeck(){closeDeck();const bg=document.createElement("div");bg.className="deckBg";bg.id="deckBg";
 bg.innerHTML=`<div class="deckTop"><span>Designing for volume · concepts — use ← → or click the sides</span><button class="btn" id="deckClose">✕ Close</button></div><iframe src="concepts.html" title="Concepts presentation"></iframe>`;
 document.body.appendChild(bg);document.getElementById("deckClose").onclick=closeDeck;
 const f=bg.querySelector("iframe");f.addEventListener("load",()=>{try{f.contentWindow.focus()}catch(e){}});}
function closeDeck(){const b=document.getElementById("deckBg");if(b)b.remove();}
document.getElementById("guideBtn").onclick=e=>{e.stopPropagation();openGuide();};
document.getElementById("deckBtn").onclick=e=>{e.stopPropagation();closeGuide();openDeck();};
addEventListener("keydown",e=>{if(e.key==="Escape"){if(document.getElementById("deckBg"))closeDeck();else closeGuide();}});
/* links from settings and results into the guide */
document.addEventListener("click",e=>{const g=e.target.closest("[data-guide]");if(g){e.stopPropagation();openGuide(g.dataset.guide);}},true);
</script>

</body>
</html>
