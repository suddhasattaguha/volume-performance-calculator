<style>
:root{--bg:#f4f4f0;--card:#fff;--ink:#1c1c1a;--mute:#6a6a64;--line:#e0dfd9;--acc:#3451c7;--accbg:#edf0fd;
--fit:#2e8b57;--fitbg:#e2f3e6;--ad:#c27c0e;--adbg:#fbefd8;--be:#c62f26;--bebg:#fde8e6;--idle:#b9b8b1;--idlebg:#fafaf7}
@media (prefers-color-scheme:dark){:root{--bg:#131312;--card:#1f1f1d;--ink:#ecebe6;--mute:#a2a19b;--line:#34332f;--acc:#93a8ff;--accbg:#232842;--fit:#6fcf97;--fitbg:#1b3022;--ad:#f2b55a;--adbg:#382c15;--be:#f28b82;--bebg:#3a1d1c;--idle:#5a5953;--idlebg:#1a1a18}}
*{box-sizing:border-box}
body{margin:0;font:15px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--ink)}
main{max-width:1100px;margin:0 auto;padding:16px 14px 40px}
header{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
h1{font-size:22px;margin:0}
.sub{color:var(--mute);margin:2px 0 0;font-size:14px}
.tools{display:flex;gap:8px;align-items:center}
.btn{padding:7px 12px;border:1px solid var(--line);border-radius:999px;background:var(--card);color:var(--ink);font-weight:600;cursor:pointer;font-size:13px}
.btn:hover{border-color:var(--acc)}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:999px;overflow:hidden;background:var(--card)}
.seg button{border:0;background:none;padding:7px 14px;font-weight:600;color:var(--mute);cursor:pointer;font-size:13px}
.seg button.on{background:var(--acc);color:#fff}
.gear{width:34px;height:34px;border-radius:50%;border:1px solid transparent;background:none;color:var(--mute);cursor:pointer;display:flex;align-items:center;justify-content:center;opacity:.55}
.gear:hover{opacity:1;border-color:var(--line);background:var(--card)}
.gear svg{width:18px;height:18px}
.gear.mod{opacity:1;color:var(--acc)}

/* stage */
.stage{position:relative;background:var(--card);border:1px solid var(--line);border-radius:18px;margin-top:14px;padding:6px 6px 0}
.scroller{overflow-x:auto}
@media(max-width:640px){svg.flow{min-width:720px}}
.hint{position:absolute;left:16px;top:12px;font-size:12.5px;color:var(--mute);pointer-events:none}
svg.flow{width:100%;height:auto;display:block;user-select:none}
.hit{cursor:pointer}
.hit:hover .ring,.hit:focus .ring{stroke-width:5}
.hit:focus{outline:none}
.nodeLbl{font-size:17px;font-weight:700;fill:var(--ink);text-anchor:middle}
.nodeSub{font-size:12.5px;fill:var(--mute);text-anchor:middle}
.zoneTxt{font-size:12.5px;font-weight:800;text-anchor:middle}
.glyph{stroke:var(--ink);fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
@keyframes flow{to{stroke-dashoffset:-48}}
@keyframes spin{to{transform:rotate(360deg)}}
.dots{animation:flow linear infinite}
.spin{transform-box:fill-box;transform-origin:center;animation:spin linear infinite}
.pulse{animation:pulse 1.6s ease-in-out infinite}
@keyframes pulse{50%{opacity:.35}}
@media (prefers-reduced-motion:reduce){.dots,.spin,.pulse{animation:none}}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--mute);padding:6px 12px 12px}
.legend span::before{content:"";display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:5px;vertical-align:-1px;background:var(--c)}

/* attribute card */
.pop{position:absolute;z-index:20;width:340px;max-width:calc(100% - 16px);background:var(--card);border:1px solid var(--line);border-radius:16px;box-shadow:0 12px 40px rgba(0,0,0,.18);padding:14px 16px 12px}
.pop h3{margin:0;font-size:16px;display:flex;align-items:center;gap:8px}
.pop .why{font-size:12.5px;color:var(--mute);margin:3px 0 8px}
.pop .x{position:absolute;right:10px;top:8px;border:0;background:none;font-size:20px;color:var(--mute);cursor:pointer}
.fld{margin:12px 0}
.fld .lab{display:flex;justify-content:space-between;align-items:baseline;font-size:13.5px;font-weight:600;gap:8px}
.fld .val{font-weight:800;color:var(--acc);font-variant-numeric:tabular-nums;white-space:nowrap}
.fld .sm{font-size:11.5px;color:var(--mute);font-weight:400}
input[type=range]{width:100%;accent-color:var(--acc);margin:6px 0 0}
.ticks{display:flex;justify-content:space-between;font-size:10.5px;color:var(--mute);margin-top:-2px;padding:0 2px}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
.chip{border:1.5px solid var(--line);background:var(--bg);color:var(--ink);border-radius:999px;padding:5px 11px;cursor:pointer;font-size:13px}
.chip.on{border-color:var(--acc);background:var(--accbg);color:var(--acc);font-weight:700}
.numrow{display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:13.5px;font-weight:600}
.numrow span{white-space:nowrap}
.numrow label{flex:1}
.numrow input{width:100px;padding:6px 8px;border:1.5px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink);font-size:15px;text-align:right;font-weight:700}
.numrow input:focus{border-color:var(--acc);outline:none}
.numrow select{padding:6px;border:1.5px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink);font-size:14px}
.chip .sm{font-size:11px;color:var(--mute);font-weight:400}
.toggle{display:flex;align-items:center;gap:8px;font-size:13.5px;font-weight:600;cursor:pointer}
.toggle input{width:18px;height:18px;accent-color:var(--acc)}
.verdictBox{border-radius:10px;padding:8px 10px;font-size:13px;margin-top:10px}
.verdictBox.F{background:var(--fitbg)}.verdictBox.A{background:var(--adbg)}.verdictBox.B{background:var(--bebg)}
.verdictBox b{display:block}
@media(max-width:640px){.pop{position:fixed;left:8px!important;right:8px;top:auto!important;bottom:8px;width:auto;max-height:72vh;overflow:auto}}

/* results */
.res{display:grid;grid-template-columns:1.3fr 1fr;gap:12px;margin-top:12px}
@media(max-width:820px){.res{grid-template-columns:1fr}}
.box{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px 16px}
.box h3{margin:0 0 8px;font-size:15px}
.big{display:flex;align-items:center;gap:12px}
.pill{font-weight:800;border-radius:999px;padding:6px 14px;font-size:15px;white-space:nowrap}
.pill.F{background:var(--fitbg);color:var(--fit)}.pill.A,.pill.G{background:var(--adbg);color:var(--ad)}.pill.B{background:var(--bebg);color:var(--be)}
.todo{padding-left:0;list-style:none;margin:10px 0 0}
.todo li{margin:7px 0;font-size:14px;cursor:pointer}
.z{font-size:11px;font-weight:800;padding:1px 7px;border-radius:4px;margin-right:6px}
.z.F{background:var(--fitbg);color:var(--fit)}.z.A{background:var(--adbg);color:var(--ad)}.z.B{background:var(--bebg);color:var(--be)}
.nums{width:100%;border-collapse:collapse;font-size:13px}
.nums td{padding:5px 2px;border-top:1px solid var(--line)}
.nums td:last-child{text-align:right;font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap;padding-left:8px}
.note{color:var(--mute);font-size:12px}
a{color:var(--acc)}

/* settings */
.modalBg{position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:50;display:flex;align-items:flex-start;justify-content:center;padding:30px 10px;overflow:auto}
.modal{background:var(--card);border-radius:16px;max-width:760px;width:100%;padding:16px 18px;border:1px solid var(--line)}
.modal h2{margin:0;font-size:18px}
.modal h4{margin:16px 0 4px;font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:var(--mute)}
.modal table{width:100%;border-collapse:collapse;font-size:13px}
.modal td{border-top:1px solid var(--line);padding:5px 4px;vertical-align:middle}
.modal input{width:96px;padding:5px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--ink);text-align:right;font-size:13.5px}
.modal tr.chg td{background:var(--adbg)}
.conf{font-weight:800;font-size:11px;color:var(--mute)}
</style>